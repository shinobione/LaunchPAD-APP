{
  "id": "/",
  "name": "SHINOBIWAN LaunchPAD",
  "short_name": "SHINOBIWAN",
  "description": "An immersive music launchpad for SHINOBIWAN releases, albums, lyrics and reactive visuals.",
  "start_url": "/LaunchPAD-APP/#home",
  "scope": "/LaunchPAD-APP/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#05030b",
  "theme_color": "#07040f",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "assets/app-icon-neon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-neon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-neon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-neon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "./#home",
      "icons": [{ "src": "assets/app-icon-neon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "url": "./#favorites",
      "icons": [{ "src": "assets/app-icon-neon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Audio Lab",
      "short_name": "Audio Lab",
      "url": "./#lab",
      "icons": [{ "src": "assets/app-icon-neon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
