{
  "id": "./",
  "name": "SHINOBIWAN Launchpad",
  "short_name": "SHINOBIWAN",
  "description": "An immersive music launchpad for SHINOBIWAN releases, albums, lyrics and reactive visuals.",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#05030b",
  "theme_color": "#07040f",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "assets/pwa-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "assets/pwa-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "./#home",
      "icons": [{ "src": "assets/pwa-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "url": "./#favorites",
      "icons": [{ "src": "assets/pwa-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Audio Lab",
      "short_name": "Audio Lab",
      "url": "./#lab",
      "icons": [{ "src": "assets/pwa-icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
