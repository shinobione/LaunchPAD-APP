
const QUALITY_VIDEO_WARNING_BYTES = 25 * 1024 * 1024;
const QUALITY_VIDEO_MAX_BYTES = 50 * 1024 * 1024;
const QUALITY_COVER_MINIMUM = 512;
const QUALITY_COVER_RECOMMENDED = 1000;
const QUALITY_DURATION_MINIMUM_TOLERANCE = 3;
const QUALITY_CANVAS_RATIO = 9 / 16;

function qualityItem(level, code, label, message, details = {}) {
  return { level, code, label, message, ...details };
}

function qualityCounts(items) {
  return items.reduce((counts, item) => {
    counts[item.level] = (counts[item.level] || 0) + 1;
    return counts;
  }, { error: 0, warning: 0, info: 0, pass: 0 });
}

function qualitySummary(items) {
  const counts = qualityCounts(items);
  return {
    counts,
    publishable: counts.error === 0,
    state: counts.error ? "blocked" : counts.warning ? "review" : "ready",
  };
}

function objectContentType(object, filename = "") {
  return object?.httpMetadata?.contentType || guessContentType(getExtension(filename));
}

function declaredObject(objectsByKey, manifest, kind) {
  const filename = manifest.assets?.[kind];
  if (!filename) return null;
  return objectsByKey.get(trackPrefix(manifest.slug) + filename) || null;
}

function timestampSequence(raw) {
  const lines = stripLyricsMetadata(raw).split("\n");
  const bracketed = /\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]/g;
  const naked = /^(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?(?:\s+.*)?$/;
  const values = [];
  for (const sourceLine of lines) {
    const line = sourceLine.trim();
    if (!line) continue;
    const tags = [...line.matchAll(bracketed)];
    if (tags.length) {
      tags.forEach(tag => values.push(timestampSeconds(tag[1], tag[2], tag[3])));
      continue;
    }
    const nakedMatch = line.match(naked);
    if (nakedMatch) values.push(timestampSeconds(nakedMatch[1], nakedMatch[2], nakedMatch[3]));
  }
  return values;
}

function listLooksHealthy(value, { required = false, label = "Liste" } = {}) {
  if (!Array.isArray(value) || value.length === 0) {
    return required
      ? qualityItem("warning", "metadata-list-missing", label, label + " non renseigné(e).")
      : qualityItem("info", "metadata-list-optional", label, label + " non renseigné(e), champ facultatif.");
  }
  const malformed = value.filter(item => !String(item || "").trim() || String(item).length > 80);
  if (malformed.length) {
    return qualityItem("warning", "metadata-list-format", label, label + " contient une valeur vide ou trop longue.", { values: malformed });
  }
  return qualityItem("pass", "metadata-list-ok", label, label + " correctement formaté(e).", { count: value.length });
}

function evidenceNumber(evidence, section, field) {
  const value = Number(evidence?.[section]?.[field]);
  return Number.isFinite(value) ? value : null;
}

function evidenceBoolean(evidence, section, field) {
  const value = evidence?.[section]?.[field];
  return typeof value === "boolean" ? value : null;
}

async function inspectTrackQuality(bucket, manifest, objects, evidence = {}) {
  const items = [];
  const prefix = trackPrefix(manifest.slug);
  const objectsByKey = new Map(objects.map(object => [object.key, object]));
  const expectedKeys = new Set([prefix + MANIFEST_NAME]);

  const add = item => items.push(item);
  const pass = (code, label, message, details) => add(qualityItem("pass", code, label, message, details));
  const info = (code, label, message, details) => add(qualityItem("info", code, label, message, details));
  const warn = (code, label, message, details) => add(qualityItem("warning", code, label, message, details));
  const error = (code, label, message, details) => add(qualityItem("error", code, label, message, details));

  if (/^[a-z0-9][a-z0-9-]{0,119}$/.test(manifest.slug)) pass("slug-valid", "Slug", "Slug valide.");
  else error("slug-invalid", "Slug", "Le slug doit contenir uniquement des minuscules, chiffres et tirets.");

  if (manifest.title?.trim()) pass("title-present", "Titre", "Titre renseigné.");
  else error("title-missing", "Titre", "Le titre est obligatoire.");

  for (const kind of ASSET_KINDS) {
    const filename = manifest.assets?.[kind];
    if (!filename) continue;
    const key = prefix + filename;
    expectedKeys.add(key);
    if (!objectsByKey.has(key)) {
      error("asset-missing-r2", kind, "Le manifest référence un fichier R2 absent : " + filename + ".", { kind, filename, key });
    }
  }

  const audioObject = declaredObject(objectsByKey, manifest, "audio");
  if (!manifest.assets?.audio) error("audio-missing", "Audio", "Aucun fichier audio déclaré.");
  else if (!audioObject) error("audio-r2-missing", "Audio", "Le fichier audio déclaré est absent de R2.");
  else {
    const type = objectContentType(audioObject, manifest.assets.audio);
    if (!String(type).startsWith("audio/")) warn("audio-content-type", "Audio", "Le type MIME audio est inhabituel : " + type + ".");
    else pass("audio-present", "Audio", "Audio présent dans R2.", { size: audioObject.size, contentType: type });
    const readable = evidenceBoolean(evidence, "audio", "readable");
    if (readable === false) error("audio-unreadable", "Audio", "Le navigateur ne peut pas lire les métadonnées du fichier audio.");
    else if (readable === true) pass("audio-readable", "Audio", "Audio lisible dans le Track Manager.");
    else info("audio-readability-unknown", "Audio", "Présence R2 vérifiée ; décodage navigateur à contrôler avant publication.");
  }

  const actualDuration = evidenceNumber(evidence, "audio", "duration");
  if (manifest.duration == null) warn("duration-missing", "Durée", "Durée du morceau non renseignée.");
  else if (manifest.duration <= 0) error("duration-invalid", "Durée", "La durée doit être supérieure à zéro.");
  else if (actualDuration != null) {
    const tolerance = Math.max(QUALITY_DURATION_MINIMUM_TOLERANCE, actualDuration * 0.03);
    const difference = Math.abs(manifest.duration - actualDuration);
    if (difference > tolerance) {
      error("duration-mismatch", "Durée", "La durée du manifest diffère de l’audio de " + difference.toFixed(1) + " s.", {
        manifestDuration: manifest.duration,
        measuredDuration: actualDuration,
        tolerance,
      });
    } else pass("duration-coherent", "Durée", "Durée du manifest cohérente avec l’audio.", { difference, tolerance });
  } else info("duration-unmeasured", "Durée", "Durée déclarée ; mesure audio non disponible pour cette vérification.");

  const coverObject = declaredObject(objectsByKey, manifest, "cover");
  if (!manifest.assets?.cover) error("cover-missing", "Cover", "Aucune pochette déclarée.");
  else if (!coverObject) error("cover-r2-missing", "Cover", "La pochette déclarée est absente de R2.");
  else pass("cover-present", "Cover", "Cover présente dans R2.", { size: coverObject.size, contentType: objectContentType(coverObject, manifest.assets.cover) });

  const coverReadable = evidenceBoolean(evidence, "cover", "readable");
  const coverWidth = evidenceNumber(evidence, "cover", "width");
  const coverHeight = evidenceNumber(evidence, "cover", "height");
  if (coverReadable === false) error("cover-unreadable", "Cover", "La pochette est illisible.");
  else if (coverWidth != null && coverHeight != null) {
    const minimum = Math.min(coverWidth, coverHeight);
    if (minimum < QUALITY_COVER_MINIMUM) error("cover-too-small", "Cover", "La pochette mesure moins de 512 px sur son petit côté.", { width: coverWidth, height: coverHeight });
    else if (minimum < QUALITY_COVER_RECOMMENDED) warn("cover-small", "Cover", "La pochette est exploitable mais inférieure aux 1000 px recommandés.", { width: coverWidth, height: coverHeight });
    else pass("cover-dimensions", "Cover", "Dimensions de pochette suffisantes.", { width: coverWidth, height: coverHeight });
  } else if (manifest.assets?.cover) info("cover-dimensions-unknown", "Cover", "Présence R2 vérifiée ; dimensions à mesurer dans le navigateur.");

  const thumbnailObject = declaredObject(objectsByKey, manifest, "thumbnail");
  if (!manifest.assets?.thumbnail) warn("thumbnail-missing", "Thumbnail", "Aucune miniature optimisée déclarée.");
  else if (!thumbnailObject) error("thumbnail-r2-missing", "Thumbnail", "La miniature déclarée est absente de R2.");
  else if (thumbnailObject.size > MAX_THUMBNAIL_BYTES) error("thumbnail-too-large", "Thumbnail", "La miniature dépasse 2 Mo.", { size: thumbnailObject.size });
  else if (thumbnailObject.size > 350 * 1024) warn("thumbnail-heavy", "Thumbnail", "La miniature est valide mais plus lourde que 350 Ko.", { size: thumbnailObject.size });
  else pass("thumbnail-optimized", "Thumbnail", "Miniature optimisée présente.", { size: thumbnailObject.size });

  const thumbnailWidth = evidenceNumber(evidence, "thumbnail", "width");
  const thumbnailHeight = evidenceNumber(evidence, "thumbnail", "height");
  if (thumbnailWidth != null && thumbnailHeight != null) {
    if (thumbnailWidth !== thumbnailHeight || thumbnailWidth < 512) warn("thumbnail-dimensions", "Thumbnail", "La miniature devrait être carrée et mesurer au moins 512 px.", { width: thumbnailWidth, height: thumbnailHeight });
    else pass("thumbnail-square", "Thumbnail", "Miniature carrée 512 px ou plus.", { width: thumbnailWidth, height: thumbnailHeight });
  }

  const lyricsObject = declaredObject(objectsByKey, manifest, "lyrics");
  let timestampValues = [];
  if (!manifest.assets?.lyrics) info("lyrics-absent", "Lyrics", "Aucun fichier de paroles ; le lecteur l’indiquera clairement.");
  else if (!lyricsObject) error("lyrics-r2-missing", "Lyrics", "Le fichier de paroles déclaré est absent de R2.");
  else if (lyricsObject.size > MAX_LYRICS_BYTES) error("lyrics-too-large", "Lyrics", "Le fichier de paroles dépasse 1 Mo.", { size: lyricsObject.size });
  else {
    try {
      const lyricsStored = await bucket.get(lyricsObject.key);
      const lyricsText = lyricsStored ? await lyricsStored.text() : "";
      if (!lyricsText.trim()) error("lyrics-empty", "Lyrics", "Le fichier de paroles est vide.");
      else {
        pass("lyrics-readable", "Lyrics", "Paroles présentes et lisibles.", { size: lyricsObject.size });
        timestampValues = timestampSequence(lyricsText);
        if (!timestampValues.length) info("lyrics-unsynced", "Synchronisation", "Paroles non timestampées ; le lecteur les signalera comme non synchronisées.");
        else {
          const outOfOrder = timestampValues.some((value, index) => index > 0 && value < timestampValues[index - 1]);
          if (outOfOrder) error("timestamps-order", "Synchronisation", "Les timestamps ne sont pas triés dans l’ordre chronologique.", { count: timestampValues.length });
          else pass("timestamps-present", "Synchronisation", timestampValues.length + " timestamp(s) trié(s).", { count: timestampValues.length });
          const lastTimestamp = timestampValues[timestampValues.length - 1];
          const referenceDuration = actualDuration ?? manifest.duration;
          if (referenceDuration != null && lastTimestamp > referenceDuration + 2) {
            error("timestamps-after-audio", "Synchronisation", "Le dernier timestamp dépasse la fin du morceau.", { lastTimestamp, duration: referenceDuration });
          } else if (referenceDuration != null) pass("timestamps-within-audio", "Synchronisation", "Le dernier timestamp reste dans la durée du morceau.", { lastTimestamp, duration: referenceDuration });
        }
      }
    } catch (cause) {
      error("lyrics-unreadable", "Lyrics", "Impossible de lire le fichier de paroles dans R2.", { details: String(cause?.message || cause) });
    }
  }

  if (manifest.year == null) warn("year-missing", "Année", "Année de sortie non renseignée.");
  else if (manifest.year < 1900 || manifest.year > 2200) error("year-invalid", "Année", "Année de sortie invalide.", { year: manifest.year });
  else pass("year-valid", "Année", "Année de sortie valide.", { year: manifest.year });

  if (manifest.energy) pass("energy-present", "Énergie", "Énergie renseignée.");
  else warn("energy-missing", "Énergie", "Énergie non renseignée.");

  add(listLooksHealthy(manifest.genres, { required: true, label: "Genres" }));
  add(listLooksHealthy(manifest.moods, { required: false, label: "Moods" }));
  add(listLooksHealthy(manifest.themes, { required: false, label: "Thèmes" }));
  add(listLooksHealthy(manifest.languages, { required: true, label: "Langues" }));

  if (manifest.keyConfidence != null && manifest.keyConfidence < 0.5) warn("key-low-confidence", "Tonalité", "Tonalité à faible confiance.", { key: manifest.key, confidence: manifest.keyConfidence });
  else if (manifest.key && manifest.keyConfidence != null) pass("key-confidence", "Tonalité", "Confiance de tonalité acceptable.", { key: manifest.key, confidence: manifest.keyConfidence });
  else info("key-unreviewed", "Tonalité", "Tonalité ou confiance non renseignée.");

  const videoObject = declaredObject(objectsByKey, manifest, "video");
  if (!manifest.assets?.video) info("canvas-absent", "Canvas", "Aucun Canvas, média facultatif.");
  else if (!videoObject) error("canvas-r2-missing", "Canvas", "Le Canvas déclaré est absent de R2.");
  else {
    if (videoObject.size > QUALITY_VIDEO_MAX_BYTES) error("canvas-too-large", "Canvas", "Le Canvas dépasse 50 Mo.", { size: videoObject.size });
    else if (videoObject.size > QUALITY_VIDEO_WARNING_BYTES) warn("canvas-heavy", "Canvas", "Le Canvas dépasse 25 Mo et peut charger lentement.", { size: videoObject.size });
    else pass("canvas-size", "Canvas", "Taille du Canvas acceptable.", { size: videoObject.size });
    const videoReadable = evidenceBoolean(evidence, "video", "readable");
    const width = evidenceNumber(evidence, "video", "width");
    const height = evidenceNumber(evidence, "video", "height");
    if (videoReadable === false) error("canvas-unreadable", "Canvas", "Le fichier Canvas est illisible.");
    else if (width != null && height != null) {
      const ratio = width / height;
      const difference = Math.abs(ratio - QUALITY_CANVAS_RATIO);
      if (height <= width || difference > 0.09) error("canvas-ratio", "Canvas", "Le Canvas doit être vertical et proche du ratio 9:16.", { width, height, ratio });
      else if (difference > 0.035) warn("canvas-ratio-near", "Canvas", "Le Canvas est vertical mais s’écarte légèrement du ratio 9:16.", { width, height, ratio });
      else pass("canvas-ratio-valid", "Canvas", "Canvas vertical proche de 9:16.", { width, height, ratio });
    } else info("canvas-dimensions-unknown", "Canvas", "Présence R2 vérifiée ; dimensions à mesurer dans le navigateur.");
  }

  const objectCandidates = objects.filter(object => object.key.startsWith(prefix) && object.key !== prefix + MANIFEST_NAME);
  const orphans = objectCandidates.filter(object => !expectedKeys.has(object.key)).map(object => object.key);
  if (orphans.length) warn("orphan-assets", "R2", orphans.length + " fichier(s) orphelin(s) détecté(s).", { keys: orphans });
  else pass("no-orphans", "R2", "Aucun fichier orphelin dans le dossier du morceau.");

  const duplicates = [];
  for (const kind of ASSET_KINDS) {
    const matches = objectCandidates.filter(object => filenameFromKey(object.key).toLowerCase().startsWith(kind + "."));
    if (matches.length > 1) duplicates.push({ kind, keys: matches.map(object => object.key) });
  }
  if (duplicates.length) warn("duplicate-assets", "R2", "Plusieurs fichiers du même type sont présents.", { duplicates });
  else pass("no-duplicates", "R2", "Aucun doublon de média détecté.");

  const summary = qualitySummary(items);
  return {
    schemaVersion: 1,
    checkedAt: new Date().toISOString(),
    slug: manifest.slug,
    status: manifest.status,
    items,
    ...summary,
    timestampsAvailable: timestampValues.length > 0,
    lastTimestamp: timestampValues.length ? timestampValues[timestampValues.length - 1] : null,
    orphanKeys: orphans,
    duplicateAssets: duplicates,
  };
}

function publicationQualityMessage(report) {
  const blockers = report.items.filter(item => item.level === "error");
  if (!blockers.length) return "";
  const first = blockers[0];
  return "Publication bloquée : " + first.message + (blockers.length > 1 ? " (et " + (blockers.length - 1) + " autre(s) erreur(s))." : "");
}

async function enrichTrackSummariesQuality(tracks, objects, bucket) {
  return Promise.all(tracks.map(async track => {
    const manifest = await readManifest(bucket, track.slug);
    if (!manifest) return track;
    const scoped = objects.filter(object => object.key.startsWith(trackPrefix(track.slug)));
    const quality = await inspectTrackQuality(bucket, manifest, scoped);
    return {
      ...track,
      complete: quality.counts.error === 0,
      quality: {
        state: quality.state,
        publishable: quality.publishable,
        counts: quality.counts,
        timestampsAvailable: quality.timestampsAvailable,
      },
    };
  }));
}
