// Phase 6 hotfix: canonical protected media must support byte ranges so
// HTMLAudioElement/HTMLVideoElement can seek to timestamped Lyrics positions.
const phase6BaseStudioCorsHeaders = studioCorsHeaders;
studioCorsHeaders = function phase6StudioCorsHeaders(request) {
  const headers = phase6BaseStudioCorsHeaders(request);
  if (headers["Access-Control-Allow-Origin"] === STUDIO_ALLOWED_ORIGIN) {
    headers["Access-Control-Allow-Headers"] = "Content-Type, Range";
    headers["Access-Control-Expose-Headers"] = "Accept-Ranges, Content-Range, Content-Length, ETag";
  }
  return headers;
};

function phase6ParseSingleByteRange(rangeHeader, size) {
  const source = String(rangeHeader || "").trim();
  if (!source) return null;
  const match = source.match(/^bytes=(\d*)-(\d*)$/i);
  if (!match || source.includes(",") || !Number.isSafeInteger(size) || size < 0) return { invalid: true };

  const startRaw = match[1];
  const endRaw = match[2];
  if (!startRaw && !endRaw) return { invalid: true };
  if (size === 0) return { invalid: true };

  let start;
  let end;
  if (!startRaw) {
    const suffix = Number(endRaw);
    if (!Number.isSafeInteger(suffix) || suffix <= 0) return { invalid: true };
    const length = Math.min(suffix, size);
    start = size - length;
    end = size - 1;
  } else {
    start = Number(startRaw);
    if (!Number.isSafeInteger(start) || start < 0 || start >= size) return { invalid: true };
    if (!endRaw) {
      end = size - 1;
    } else {
      end = Number(endRaw);
      if (!Number.isSafeInteger(end) || end < start) return { invalid: true };
      end = Math.min(end, size - 1);
    }
  }

  return { start, end, length: end - start + 1 };
}

function phase6ProtectedMediaHeaders(object, size) {
  const headers = new Headers(corsSafeHeaders());
  object.writeHttpMetadata(headers);
  if (object.httpEtag) headers.set("ETag", object.httpEtag);
  headers.set("Cache-Control", "private, no-store");
  headers.set("Content-Disposition", "inline");
  headers.set("Accept-Ranges", "bytes");
  headers.set("Content-Length", String(size));
  return headers;
}

getProtectedMedia = async function phase6GetProtectedMedia(request, slug, kind, env) {
  const manifest = await readManifest(env.MEDIA_BUCKET, slug);
  const filename = manifest?.assets?.[kind];
  if (!filename) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);

  const key = trackPrefix(slug) + filename;
  const metadata = await env.MEDIA_BUCKET.head(key);
  if (!metadata) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);

  const size = Number(metadata.size || 0);
  const rangeHeader = request.headers.get("range");
  const range = phase6ParseSingleByteRange(rangeHeader, size);

  if (range?.invalid) {
    const headers = phase6ProtectedMediaHeaders(metadata, 0);
    headers.set("Content-Range", `bytes */${size}`);
    return new Response(null, { status: 416, headers });
  }

  if (range) {
    const object = await env.MEDIA_BUCKET.get(key, {
      range: { offset: range.start, length: range.length },
    });
    if (!object || !object.body) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);

    const headers = phase6ProtectedMediaHeaders(object, range.length);
    headers.set("Content-Range", `bytes ${range.start}-${range.end}/${size}`);
    return new Response(object.body, { status: 206, headers });
  }

  const object = await env.MEDIA_BUCKET.get(key);
  if (!object || !object.body) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);
  const headers = phase6ProtectedMediaHeaders(object, size);
  return new Response(object.body, { status: 200, headers });
};
