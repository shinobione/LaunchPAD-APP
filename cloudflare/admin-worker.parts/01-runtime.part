const TRACKS_PREFIX = "tracks/";
const LEGACY_PREFIX = "media/";
const MANIFEST_NAME = "manifest.json";
const CATALOG_INDEX_KEY = "catalog/index.json";
const THUMBNAIL_NAME = "thumbnail.webp";
const MAX_UPLOAD_BYTES = 50 * 1024 * 1024;
const MAX_THUMBNAIL_BYTES = 2 * 1024 * 1024;
const MAX_LYRICS_BYTES = 1024 * 1024;
const MAX_BODY_OVERHEAD = 4 * 1024 * 1024;
const MAX_LIST_PAGES = 20;
const DEFAULT_MIGRATION_MANIFEST_URL = "https://raw.githubusercontent.com/shinobione/LaunchPAD-APP/main/cloudflare/migration-manifest.json";
const STUDIO_ALLOWED_ORIGIN = "https://shinobione.github.io";
const STUDIO_BRIDGE_VERSION = "1.0";

const ALLOWED_EXTENSIONS = new Set([
  "jpg", "jpeg", "png", "webp", "gif",
  "mp3", "wav", "flac", "m4a", "aac", "ogg",
  "mp4", "webm", "txt", "json"
]);

const ASSET_KINDS = ["audio", "cover", "thumbnail", "lyrics", "video"];
const STATUS_VALUES = new Set(["draft", "published", "archived"]);

let jwksCache = { url: "", keys: null, expiresAt: 0 };

function assertStudioReadOrigin(request) {
  const origin = request.headers.get("origin");
  if (origin && origin !== STUDIO_ALLOWED_ORIGIN) throw new Error("AUTH_Origine Studio refusée.");
}

function studioCorsHeaders(request) {
  const origin = request.headers.get("origin");
  if (origin !== STUDIO_ALLOWED_ORIGIN) return {};
  return {
    "Access-Control-Allow-Origin": STUDIO_ALLOWED_ORIGIN,
    "Access-Control-Allow-Credentials": "true",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Max-Age": "600",
    "Vary": "Origin",
  };
}

function withStudioCors(request, response) {
  const headers = new Headers(response.headers);
  for (const [name, value] of Object.entries(studioCorsHeaders(request))) headers.set(name, value);
  return new Response(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers,
  });
}

function studioCorsPreflight(request) {
  const origin = request.headers.get("origin");
  const requestedMethod = String(request.headers.get("access-control-request-method") || "").toUpperCase();
  if (origin !== STUDIO_ALLOWED_ORIGIN || requestedMethod !== "GET") {
    return jsonResponse({ ok: false, error: "Accès refusé." }, 403);
  }
  return new Response(null, { status: 204, headers: studioCorsHeaders(request) });
}

export default {
  async fetch(request, env) {
    try {
      const url = new URL(request.url);

      if (request.method === "OPTIONS" && url.pathname.startsWith("/api/studio/")) {
        return studioCorsPreflight(request);
      }

      const user = await verifyAccessJwt(request, env);

      if (["POST", "PUT", "PATCH", "DELETE"].includes(request.method)) {
        enforceSameOrigin(request, url);
      }

      if (request.method === "GET" && (url.pathname === "/" || url.pathname === "/admin")) {
        return htmlResponse(renderAdminPage(user.email || "Utilisateur autorisé"));
      }

      if (request.method === "GET" && url.pathname === "/health") {
        const canonical = await listAllObjects(env.MEDIA_BUCKET, TRACKS_PREFIX);
        const legacy = await listAllObjects(env.MEDIA_BUCKET, LEGACY_PREFIX);
        return jsonResponse({
          ok: true,
          service: "launchpad-r2-track-manager",
          version: "4.6",
          authenticatedEmail: user.email || null,
          canonicalObjects: canonical.length,
          legacyObjects: legacy.length,
          migrationManifestUrl: getMigrationManifestUrl(env),
        });
      }

      if (request.method === "GET" && url.pathname === "/api/studio/health") {
        assertStudioReadOrigin(request);
        return withStudioCors(request, jsonResponse({
          ok: true,
          service: "launchpad-r2-track-manager-studio-bridge",
          version: STUDIO_BRIDGE_VERSION,
          trackManagerVersion: "5.8",
          authenticatedEmail: user.email || null,
          allowedOrigin: STUDIO_ALLOWED_ORIGIN,
          capabilities: {
            read: ["tracks", "track"],
            write: [],
          },
        }));
      }

      if (request.method === "GET" && url.pathname === "/api/studio/tracks") {
        assertStudioReadOrigin(request);
        return withStudioCors(request, await listTracks(env));
      }

      const studioTrackMatch = url.pathname.match(/^\/api\/studio\/tracks\/([a-z0-9][a-z0-9-]{0,119})$/);
      if (studioTrackMatch && request.method === "GET") {
        assertStudioReadOrigin(request);
        return withStudioCors(request, await getTrack(studioTrackMatch[1], env));
      }

      if (request.method === "GET" && url.pathname === "/api/tracks") {
        return listTracks(env);
      }

      const mediaMatch = url.pathname.match(/^\/api\/media\/([a-z0-9][a-z0-9-]{0,119})\/(cover|thumbnail|audio|video|lyrics)$/);
      if (mediaMatch && request.method === "GET") {
        const response = await getProtectedMedia(request, mediaMatch[1], mediaMatch[2], env);
        return request.headers.get("origin") === STUDIO_ALLOWED_ORIGIN
          ? withStudioCors(request, response)
          : response;
      }

      const thumbnailMatch = url.pathname.match(/^\/api\/tracks\/([a-z0-9][a-z0-9-]{0,119})\/thumbnail$/);
      if (thumbnailMatch && request.method === "PUT") {
        return saveThumbnail(thumbnailMatch[1], request, env, user);
      }

      if (request.method === "POST" && url.pathname === "/api/catalog/rebuild") {
        const index = await writeCatalogIndex(env.MEDIA_BUCKET);
        return jsonResponse({ ok: true, index });
      }

      const trackMatch = url.pathname.match(/^\/api\/tracks\/([a-z0-9][a-z0-9-]{0,119})$/);
      if (trackMatch && request.method === "GET") {
        return getTrack(trackMatch[1], env);
      }
      if (trackMatch && request.method === "PUT") {
        return saveTrack(trackMatch[1], request, env, user);
      }
      if (trackMatch && request.method === "DELETE") {
        return deleteTrack(trackMatch[1], env);
      }

      if (request.method === "GET" && url.pathname === "/api/migration-plan") {
        return getMigrationPlan(env);
      }

      const githubImportMatch = url.pathname.match(/^\/api\/import\/github\/([a-z0-9][a-z0-9-]{0,119})$/);
      if (githubImportMatch && request.method === "POST") {
        return importGithubTrack(githubImportMatch[1], request, env, user);
      }

      const legacyImportMatch = url.pathname.match(/^\/api\/import\/legacy\/([a-z0-9][a-z0-9-]{0,119})$/);
      if (legacyImportMatch && request.method === "POST") {
        return importLegacyTrack(legacyImportMatch[1], env, user);
      }

      if (request.method === "POST" && url.pathname === "/api/import/legacy") {
        return importAllLegacyTracks(env, user);
      }

      return jsonResponse({ ok: false, error: "Route introuvable." }, 404);
    } catch (error) {
      console.error(error);
      const message = error instanceof Error ? error.message : "Erreur inconnue.";
      const isAuth = message.startsWith("AUTH_");
      const isInput = message.startsWith("INPUT_") || message.startsWith("UPLOAD_");
      const response = jsonResponse(
        {
          ok: false,
          error: isAuth ? "Accès refusé." : isInput ? "Requête invalide." : "Erreur interne.",
          details: message.replace(/^(AUTH_|INPUT_|UPLOAD_)/, ""),
        },
        isAuth ? 403 : isInput ? 400 : 500,
      );
      const url = new URL(request.url);
      return url.pathname.startsWith("/api/studio/") ? withStudioCors(request, response) : response;
    }
  },
};

async function getProtectedMedia(request, slug, kind, env) {
  const manifest = await readManifest(env.MEDIA_BUCKET, slug);
  const filename = manifest?.assets?.[kind];
  if (!filename) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);
  const object = await env.MEDIA_BUCKET.get(trackPrefix(slug) + filename);
  if (!object) return jsonResponse({ ok: false, error: "Média introuvable." }, 404);
  const headers = new Headers(corsSafeHeaders());
  object.writeHttpMetadata(headers);
  headers.set("ETag", object.httpEtag);
  headers.set("Cache-Control", "private, no-store");
  headers.set("Content-Disposition", "inline");
  return new Response(request.method === "HEAD" ? null : object.body, { headers });
}

async function listTracks(env) {
  const [canonicalObjects, legacyObjects] = await Promise.all([
    listAllObjects(env.MEDIA_BUCKET, TRACKS_PREFIX),
    listAllObjects(env.MEDIA_BUCKET, LEGACY_PREFIX),
  ]);

  const canonicalBase = await buildCanonicalTrackSummaries(canonicalObjects, env.MEDIA_BUCKET);
  const canonicalTracks = await enrichTrackSummariesQuality(canonicalBase, canonicalObjects, env.MEDIA_BUCKET);
  const legacyGroups = groupLegacyObjects(legacyObjects);
  const legacyTracks = [...legacyGroups.values()].map(group => legacySummary(group));

  const totals = canonicalTracks.reduce((acc, track) => {
    acc.total += 1;
    acc[track.status] = (acc[track.status] || 0) + 1;
    if (!track.complete) acc.incomplete += 1;
    acc.bytes += track.totalBytes;
    return acc;
  }, { total: 0, published: 0, draft: 0, archived: 0, incomplete: 0, bytes: 0 });

  return jsonResponse({
    ok: true,
    tracks: canonicalTracks,
    legacyTracks,
    totals,
  });
}

async function getTrack(slug, env) {
  const manifest = await readManifest(env.MEDIA_BUCKET, slug);
  if (!manifest) return jsonResponse({ ok: false, error: "Titre introuvable." }, 404);

  const objects = await listAllObjects(env.MEDIA_BUCKET, trackPrefix(slug));
  const assets = assetStateFromObjects(objects, manifest);
  const quality = await inspectTrackQuality(env.MEDIA_BUCKET, manifest, objects);
  return jsonResponse({
    ok: true,
    track: {
      manifest,
      assets,
      quality,
    },
  });
}

async function saveTrack(slug, request, env, user) {
  const contentLength = Number(request.headers.get("content-length") || 0);
  if (contentLength && contentLength > MAX_UPLOAD_BYTES * 5 + MAX_BODY_OVERHEAD) {
    throw new Error("UPLOAD_Envoi trop volumineux.");
  }

  const contentType = request.headers.get("content-type") || "";
  if (!contentType.toLowerCase().startsWith("multipart/form-data")) {
    throw new Error("INPUT_Le Track Manager attend un formulaire multipart.");
  }

  const formData = await request.formData();
  const metadataRaw = formData.get("metadata");
  if (typeof metadataRaw !== "string") throw new Error("INPUT_Métadonnées manquantes.");

  let metadata;
  try { metadata = JSON.parse(metadataRaw); }
  catch { throw new Error("INPUT_JSON de métadonnées invalide."); }

  let qualityEvidence = {};
  const qualityEvidenceRaw = formData.get("qualityEvidence");
  if (typeof qualityEvidenceRaw === "string" && qualityEvidenceRaw.trim()) {
    try { qualityEvidence = JSON.parse(qualityEvidenceRaw); }
    catch { throw new Error("INPUT_Preuve de contrôle qualité invalide."); }
  }

  const existing = await readManifest(env.MEDIA_BUCKET, slug);
  const createOnly = formData.get("create_only") === "true";
  if (createOnly && existing) {
    throw new Error("INPUT_Ce slug existe déjà. Ouvre le morceau existant au lieu de l’écraser.");
  }

  const manifest = normalizeManifest({
    ...existing,
    ...metadata,
    slug,
    updatedAt: new Date().toISOString(),
    updatedBy: String(user.email || "authorized-user"),
    createdAt: existing?.createdAt || new Date().toISOString(),
  });

  const currentObjects = await listAllObjects(env.MEDIA_BUCKET, trackPrefix(slug));
  const currentByKind = findAssetObjects(currentObjects, existing);

  for (const kind of ASSET_KINDS) {
    const file = formData.get(kind);
    const remove = formData.get("remove_" + kind) === "true";

    if (remove) {
      if (currentByKind[kind]) await env.MEDIA_BUCKET.delete(currentByKind[kind].key);
      manifest.assets[kind] = null;
      continue;
    }

    if (!(file instanceof File) || file.size === 0) continue;
    validateUploadFile(file, kind);

    if (currentByKind[kind]) await env.MEDIA_BUCKET.delete(currentByKind[kind].key);

    const extension = normalizedExtension(file.name, file.type, kind);
    const filename = kind + "." + extension;
    const key = trackPrefix(slug) + filename;
    const storedContentType = file.type || guessContentType(extension);

    await env.MEDIA_BUCKET.put(key, file.stream(), {
      httpMetadata: {
        contentType: storedContentType,
        cacheControl: "public, max-age=31536000, immutable",
      },
      customMetadata: {
        kind,
        slug,
        originalName: String(file.name || filename).slice(0, 300),
        uploadedBy: String(user.email || "authorized-user").slice(0, 200),
        uploadedAt: new Date().toISOString(),
      },
    });

    manifest.assets[kind] = filename;
  }

  const savedObjects = await listAllObjects(env.MEDIA_BUCKET, trackPrefix(slug));
  const quality = await inspectTrackQuality(env.MEDIA_BUCKET, manifest, savedObjects, qualityEvidence);
  if (manifest.status === "published" && !quality.publishable) {
    return jsonResponse({
      ok: false,
      error: "Publication bloquée par le contrôle qualité.",
      details: publicationQualityMessage(quality),
      quality,
      draftAllowed: true,
    }, 409);
  }

  await writeManifest(env.MEDIA_BUCKET, manifest);
  await writeCatalogIndex(env.MEDIA_BUCKET);

  return jsonResponse({ ok: true, track: manifest, quality }, existing ? 200 : 201);
}

async function saveThumbnail(slug, request, env, user) {
  const manifest = await readManifest(env.MEDIA_BUCKET, slug);
  if (!manifest) return jsonResponse({ ok: false, error: "Titre introuvable." }, 404);

  const contentType = String(request.headers.get("content-type") || "").split(";")[0].trim().toLowerCase();
  if (!new Set(["image/webp", "image/jpeg", "image/png"]).has(contentType)) {
    throw new Error("UPLOAD_La miniature doit être une image WebP, JPEG ou PNG.");
  }

  const body = await request.arrayBuffer();
  if (!body.byteLength || body.byteLength > MAX_THUMBNAIL_BYTES) {
    throw new Error("UPLOAD_La miniature doit peser moins de 2 Mo.");
  }

  const extension = extensionFromContentType(contentType) || "webp";
  const filename = "thumbnail." + extension;
  const current = manifest.assets?.thumbnail;
  if (current && current !== filename) {
    await env.MEDIA_BUCKET.delete(trackPrefix(slug) + current);
  }

  await env.MEDIA_BUCKET.put(trackPrefix(slug) + filename, body, {
    httpMetadata: {
      contentType,
      cacheControl: "public, max-age=31536000, immutable",
    },
    customMetadata: {
      kind: "thumbnail",
      slug,
      uploadedBy: String(user.email || "authorized-user").slice(0, 200),
      uploadedAt: new Date().toISOString(),
    },
  });

  manifest.assets.thumbnail = filename;
  manifest.updatedAt = new Date().toISOString();
  manifest.updatedBy = String(user.email || "authorized-user");
  await writeManifest(env.MEDIA_BUCKET, manifest);

  const defer = new URL(request.url).searchParams.get("defer") === "1";
  if (!defer) await writeCatalogIndex(env.MEDIA_BUCKET);
  return jsonResponse({ ok: true, slug, filename, size: body.byteLength });
}

async function deleteTrack(slug, env) {
  const objects = await listAllObjects(env.MEDIA_BUCKET, trackPrefix(slug));
  if (!objects.length) return jsonResponse({ ok: false, error: "Titre introuvable." }, 404);
  await deleteKeys(env.MEDIA_BUCKET, objects.map(object => object.key));
  await writeCatalogIndex(env.MEDIA_BUCKET);
  return jsonResponse({ ok: true, deleted: slug, objectCount: objects.length });
}

async function getMigrationPlan(env) {
  const plan = await fetchMigrationPlan(env);
  return jsonResponse({ ok: true, plan });
}

async function importGithubTrack(slug, request, env, user) {
  let options = {};
  try { options = await request.json(); } catch {}
  const overwrite = options?.overwrite === true;
  const existing = await readManifest(env.MEDIA_BUCKET, slug);
  if (existing && !overwrite) {
    return jsonResponse({ ok: true, skipped: true, reason: "already-exists", track: existing });
  }

  const plan = await fetchMigrationPlan(env);
  const entry = plan.tracks.find(item => item.slug === slug);
  if (!entry) return jsonResponse({ ok: false, error: "Titre absent du plan de migration." }, 404);

  if (overwrite) {
    const current = await listAllObjects(env.MEDIA_BUCKET, trackPrefix(slug));
    await deleteKeys(env.MEDIA_BUCKET, current.map(object => object.key));
  }

  const assets = { audio: null, cover: null, thumbnail: null, lyrics: null, video: null };
  const imported = [];

  for (const kind of ASSET_KINDS) {
    const sourceUrl = entry.sources?.[kind];
    if (!sourceUrl) continue;
    const result = await importRemoteAsset({
      bucket: env.MEDIA_BUCKET,
      slug,
      kind,
      sourceUrl,
      user,
    });
    assets[kind] = result.filename;
    imported.push(result);
  }

  const manifest = normalizeManifest({
    ...entry,
    assets,
