
var TRACK_MANAGER_FEATURE_10_VERSION='5.0';
state.catalogStatusFilter='all';

var feature10ManagerStyle=document.createElement('style');
feature10ManagerStyle.textContent='.stat[data-catalog-filter]{cursor:pointer;transition:transform .16s,border-color .16s,background .16s,box-shadow .16s}.stat[data-catalog-filter]:hover{transform:translateY(-2px);border-color:rgba(125,231,163,.32)}.stat[data-catalog-filter]:focus-visible{outline:2px solid rgba(125,231,163,.88);outline-offset:3px}.stat[data-catalog-filter].active{border-color:rgba(125,231,163,.52);background:linear-gradient(145deg,rgba(29,185,84,.14),rgba(13,17,15,.94));box-shadow:0 12px 34px rgba(29,185,84,.08)}.chip.content-clean{color:#89edab;background:rgba(29,185,84,.13)}.chip.content-explicit{color:#ff9aa4;background:rgba(255,70,86,.12)}.chip.content-unrated{color:#aab6af;background:rgba(255,255,255,.055)}.chip-row-break{flex-basis:100%;width:0;height:0;padding:0!important;margin:0!important;border:0!important;background:transparent!important}.stat-filter-hint{position:absolute;right:13px;top:11px;color:rgba(125,231,163,.55);font-size:.62rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}@media(max-width:700px){.stat-filter-hint{font-size:.55rem}}';
document.head.appendChild(feature10ManagerStyle);

function feature10StatusMatches(track,filter){if(filter==='published')return track.status==='published';if(filter==='draft')return track.status==='draft';if(filter==='incomplete')return !track.complete;return true}
function feature10SearchTracks(){var q=$('#search').value.trim().toLowerCase();return state.tracks.filter(function(track){return !q||[track.title,track.slug,track.album&&track.album.title,(track.genres||[]).join(' '),(track.moods||[]).join(' ')].join(' ').toLowerCase().includes(q)})}
function feature10ContentBadge(track){if(track.explicit===true)return {className:'content-explicit',label:'EXPLICIT'};if(track.explicit===false)return {className:'content-clean',label:'CLEAN'};return {className:'content-unrated',label:'CONTENU NON VÉRIFIÉ'}}
function feature10DecorateTrackCard(card,track){
  var chips=card.querySelector('.chips');if(!chips||!track)return;
  chips.querySelectorAll('[data-content-rating],.chip-row-break').forEach(function(element){element.remove()});
  var lyrics=chips.querySelector('[data-lyrics-status]');
  if(lyrics){var line=document.createElement('span');line.className='chip-row-break';line.setAttribute('aria-hidden','true');var rating=feature10ContentBadge(track);var content=document.createElement('span');content.className='chip '+rating.className;content.dataset.contentRating=rating.className;content.textContent=rating.label;lyrics.after(line,content)}
  var children=Array.from(chips.children);var thumbnailIndex=children.findIndex(function(chip){return /(?:thumbnail|cover optimisée|cover lourde)/i.test(chip.textContent||'')});
  if(thumbnailIndex>=0){children.slice(thumbnailIndex+1).filter(function(chip){return !chip.matches('[data-content-rating],.chip-row-break')}).forEach(function(chip){chip.remove()});feature10NormalizeGenres(track.genres||[]).slice(0,3).forEach(function(label){var chip=document.createElement('span');chip.className='chip';chip.textContent=label;chips.appendChild(chip)})}
}

var feature10RenderTracksBeforeManagerUI=renderTracks;
renderTracks=function(){
  feature10RenderTracksBeforeManagerUI();
  var source=feature10SearchTracks();var cards=Array.from(document.querySelectorAll('#trackGrid .track'));var visible=0;
  cards.forEach(function(card,index){var track=source[index];feature10DecorateTrackCard(card,track);var show=Boolean(track&&feature10StatusMatches(track,state.catalogStatusFilter));card.hidden=!show;if(show)visible++});
  if(cards.length&&visible===0){$('#trackGrid').innerHTML='<div class="empty"><strong>Aucun titre dans cette vue</strong><span class="sub">Change de statut ou modifie la recherche.</span></div>'}
  $('#countLabel').textContent=visible+(visible>1?' morceaux':' morceau')+(state.catalogStatusFilter==='all'?'':' · '+state.catalogStatusFilter);
};

function feature10SetCatalogFilter(filter){state.catalogStatusFilter=filter||'all';document.querySelectorAll('.stat[data-catalog-filter]').forEach(function(stat){var active=stat.dataset.catalogFilter===state.catalogStatusFilter;stat.classList.toggle('active',active);stat.setAttribute('aria-pressed',String(active))});renderTracks()}
function feature10InstallStatFilters(){
  var definitions=[['#sTotal','all'],['#sPublished','published'],['#sDraft','draft'],['#sIncomplete','incomplete']];
  definitions.forEach(function(definition){var stat=$(definition[0])?.closest('.stat');if(!stat)return;stat.dataset.catalogFilter=definition[1];stat.tabIndex=0;stat.setAttribute('role','button');stat.setAttribute('aria-pressed',String(definition[1]==='all'));stat.setAttribute('aria-label','Filtrer le catalogue : '+stat.querySelector('span')?.textContent);if(!stat.querySelector('.stat-filter-hint')){var hint=document.createElement('em');hint.className='stat-filter-hint';hint.textContent='Filtrer';stat.appendChild(hint)}});
  document.querySelector('.stat[data-catalog-filter="all"]')?.classList.add('active');
}
feature10InstallStatFilters();
document.querySelector('.stats')?.addEventListener('click',function(event){var stat=event.target.closest('.stat[data-catalog-filter]');if(stat)feature10SetCatalogFilter(stat.dataset.catalogFilter)});
document.querySelector('.stats')?.addEventListener('keydown',function(event){var stat=event.target.closest('.stat[data-catalog-filter]');if(!stat||!['Enter',' '].includes(event.key))return;event.preventDefault();feature10SetCatalogFilter(stat.dataset.catalogFilter)});
var feature10VersionPill=document.querySelector('.version-pill');if(feature10VersionPill)feature10VersionPill.textContent='v5.0';
