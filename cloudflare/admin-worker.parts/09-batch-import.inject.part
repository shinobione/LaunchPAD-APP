
var BATCH_AUDIO_EXTENSIONS=['mp3','wav','flac','m4a','aac','ogg'];
var BATCH_IMAGE_EXTENSIONS=['jpg','jpeg','png','webp','gif'];
var BATCH_LYRICS_EXTENSIONS=['txt','lrc'];
var BATCH_VIDEO_EXTENSIONS=['mp4','webm'];
var BATCH_ROLE_NAMES={audio:'Audio',cover:'Cover',lyrics:'Lyrics',video:'Canvas',ignore:'Ignorer'};
var BATCH_MAX_FILE_BYTES=50*1024*1024;
var batchAnalysisToken=0;
state.batchImport={files:[],groups:[],busy:false,objectUrls:[]};

function batchExtension(name){var value=String(name||'').toLowerCase();var dot=value.lastIndexOf('.');return dot<0?'':value.slice(dot+1)}
function batchDetectedRole(file){var extension=batchExtension(file&&file.name);if(BATCH_AUDIO_EXTENSIONS.includes(extension))return 'audio';if(BATCH_IMAGE_EXTENSIONS.includes(extension))return 'cover';if(BATCH_LYRICS_EXTENSIONS.includes(extension))return 'lyrics';if(BATCH_VIDEO_EXTENSIONS.includes(extension))return 'video';return 'ignore'}
function batchStripRoleSuffix(value){return String(value||'').replace(/(?:[-_. ](?:cover|artwork|art|thumbnail|thumb|lyrics?|lrc|canvas|video|audio|master|mix))+$/i,'')}
function batchBaseName(name){var value=String(name||'');var dot=value.lastIndexOf('.');return dot>0?value.slice(0,dot):value}
function batchGroupKey(file){var relative=String(file&&file.webkitRelativePath||file&&file.name||'').replace(/\\/g,'/');var parts=relative.split('/').filter(Boolean);if(parts.length>1){var folder=slugifyImportedTitle(parts[parts.length-2]);if(folder)return folder}return slugifyImportedTitle(batchStripRoleSuffix(batchBaseName(file&&file.name)))||'untitled'}
function batchTitleFromSlug(slug){return String(slug||'').split('-').filter(Boolean).map(function(word){return word.charAt(0).toUpperCase()+word.slice(1)}).join(' ')}
function batchGroupFiles(fileList){var grouped=new Map();Array.from(fileList||[]).forEach(function(file){var key=batchGroupKey(file);if(!grouped.has(key))grouped.set(key,{id:key,slug:key,title:batchTitleFromSlug(key),files:[],metadata:{},lyricsText:null,lyricsParse:null,analysis:{},issues:[],existing:null,mode:'create',selected:true,previewUrl:null,thumbnailResult:null});grouped.get(key).files.push({file:file,role:batchDetectedRole(file),detectedRole:batchDetectedRole(file)})});return Array.from(grouped.values())}
function batchRoleCounts(group){var counts={audio:0,cover:0,lyrics:0,video:0,ignore:0};(group.files||[]).forEach(function(entry){counts[entry.role]=(counts[entry.role]||0)+1});return counts}
function batchAssociationProblems(group,existingSlugs){var problems=[];var counts=batchRoleCounts(group);['audio','cover','lyrics','video'].forEach(function(role){if(counts[role]>1)problems.push({level:'error',code:'multiple-'+role,message:'Plusieurs fichiers '+BATCH_ROLE_NAMES[role].toLowerCase()+' sont associés.'})});if(!/^[a-z0-9][a-z0-9-]{0,119}$/.test(group.slug||''))problems.push({level:'error',code:'slug-invalid',message:'Slug invalide.'});if(existingSlugs&&existingSlugs.has(group.slug)&&group.mode!=='complete')problems.push({level:'error',code:'slug-existing',message:'Ce slug existe déjà. Choisis « Compléter l’existant » pour continuer.'});if(!counts.audio)problems.push({level:'warning',code:'audio-missing',message:'Aucun audio : le morceau sera un brouillon incomplet.'});if(!counts.cover)problems.push({level:'warning',code:'cover-missing',message:'Aucune cover : aucune thumbnail ne sera générée.'});if(counts.ignore)problems.push({level:'info',code:'ignored-files',message:counts.ignore+' fichier(s) non reconnu(s) ou ignoré(s).'});return problems}
function batchRoleFile(group,role){var entries=(group.files||[]).filter(function(entry){return entry.role===role});return entries.length===1?entries[0].file:null}
function batchIssue(level,code,message){return {level:level,code:code,message:message}}
function batchLevelIcon(level){return level==='error'?'✕':level==='warning'?'⚠':level==='pass'?'✓':'i'}
function batchDedupeFiles(files){var seen=new Set();return Array.from(files||[]).filter(function(file){var key=String(file.webkitRelativePath||file.name)+'|'+file.size+'|'+file.lastModified;if(seen.has(key))return false;seen.add(key);return true})}
function batchReleaseObjectUrls(){state.batchImport.objectUrls.forEach(function(url){URL.revokeObjectURL(url)});state.batchImport.objectUrls=[];state.batchImport.groups.forEach(function(group){group.previewUrl=null})}
function batchRememberObjectUrl(file){var url=URL.createObjectURL(file);state.batchImport.objectUrls.push(url);return url}
function batchInspectImage(file){if(!file)return Promise.resolve(null);var url=batchRememberObjectUrl(file);return Promise.race([new Promise(function(resolve,reject){var image=new Image();image.onload=function(){resolve({readable:true,width:image.naturalWidth,height:image.naturalHeight,size:file.size})};image.onerror=function(){reject(new Error('Image illisible.'))};image.src=url}),timeoutPromise('Lecture image trop longue.')]).catch(function(){return {readable:false,size:file.size}})}
function batchInspectMedia(file,kind){if(!file)return Promise.resolve(null);var url=batchRememberObjectUrl(file);return Promise.race([new Promise(function(resolve,reject){var media=document.createElement(kind==='audio'?'audio':'video');media.preload='metadata';media.muted=true;media.onloadedmetadata=function(){resolve({readable:true,duration:Number.isFinite(media.duration)?media.duration:null,width:kind==='video'?media.videoWidth:null,height:kind==='video'?media.videoHeight:null,size:file.size})};media.onerror=function(){reject(new Error('Média illisible.'))};media.src=url;media.load()}),timeoutPromise('Lecture média trop longue.')]).catch(function(){return {readable:false,size:file.size}})}
function batchMetadataValue(metadata,name,fallback){var value=metadata&&metadata[name];return value==null||value===''?fallback:value}
function batchParseExplicit(value){if(value===true||value==='true')return true;if(value===false||value==='false')return false;return null}
function batchDurationValue(value){if(value==null||value==='')return null;if(typeof value==='number')return value;try{return parseDurationInput(value)}catch(error){return null}}
function batchListValue(value){return Array.isArray(value)?value:split(value)}
function batchExistingTrack(slug){return state.tracks.find(function(track){return track.slug===slug})||null}

async function batchAnalyzeGroup(group,duplicateSlugs){group.issues=[];group.existing=batchExistingTrack(group.slug);var existingSlugs=new Set(state.tracks.map(function(track){return track.slug}));group.issues.push.apply(group.issues,batchAssociationProblems(group,existingSlugs));if(duplicateSlugs&&duplicateSlugs.has(group.slug))group.issues.push(batchIssue('error','duplicate-group-slug','Plusieurs groupes utilisent le même slug.'));
  (group.files||[]).forEach(function(entry){if(entry.file.size>BATCH_MAX_FILE_BYTES)group.issues.push(batchIssue('error','file-too-large',entry.file.name+' dépasse 50 Mo.'));var stem=slugifyImportedTitle(batchStripRoleSuffix(batchBaseName(entry.file.name)));var relative=String(entry.file.webkitRelativePath||'');if(relative&&stem&&stem!==group.slug)group.issues.push(batchIssue('warning','ambiguous-name',entry.file.name+' ne correspond pas clairement au dossier '+group.slug+'.'))});
  var lyricsFile=batchRoleFile(group,'lyrics');if(lyricsFile){try{group.lyricsText=await lyricsFile.text();group.lyricsParse=parseLyricsTxtMetadata(group.lyricsText);group.metadata=group.lyricsParse.metadata||{};if(group.metadata.title){group.title=String(group.metadata.title);var metadataSlug=slugifyImportedTitle(group.metadata.title);if(metadataSlug&&metadataSlug!==group.slug)group.issues.push(batchIssue('warning','metadata-slug-conflict','Le titre du TXT suggère le slug « '+metadataSlug+' », différent du groupe « '+group.slug+' ».'))}if(group.metadata.status==='published')group.issues.push(batchIssue('info','forced-draft','Un nouveau morceau est toujours importé en brouillon, même si le TXT demande published.'));if(!String(group.lyricsText||'').trim())group.issues.push(batchIssue('error','lyrics-empty','Le fichier Lyrics est vide.'));else group.issues.push(batchIssue('pass','lyrics-readable','Lyrics lisibles'+(timestampValuesFromText(group.lyricsText).length?' et timestampées.':' sans timestamps.'))}catch(error){group.issues.push(batchIssue('error','lyrics-unreadable','Impossible de lire le fichier Lyrics.'))}}else{group.metadata={};group.lyricsText=null;group.lyricsParse=null}
  var audioFile=batchRoleFile(group,'audio');var coverFile=batchRoleFile(group,'cover');var videoFile=batchRoleFile(group,'video');var inspected=await Promise.all([batchInspectMedia(audioFile,'audio'),batchInspectImage(coverFile),batchInspectMedia(videoFile,'video')]);group.analysis={audio:inspected[0]||{},cover:inspected[1]||{},video:inspected[2]||{}};
  if(audioFile){if(group.analysis.audio.readable===false)group.issues.push(batchIssue('error','audio-unreadable','Audio illisible.'));else{group.issues.push(batchIssue('pass','audio-readable','Audio lisible'+(Number.isFinite(group.analysis.audio.duration)?' · '+formatDurationInput(group.analysis.audio.duration):'')+'.'));if(!group.metadata.duration&&Number.isFinite(group.analysis.audio.duration))group.metadata.duration=formatDurationInput(group.analysis.audio.duration)}}
  if(coverFile){if(group.analysis.cover.readable===false)group.issues.push(batchIssue('error','cover-unreadable','Cover illisible.'));else{var minimum=Math.min(group.analysis.cover.width||0,group.analysis.cover.height||0);group.issues.push(batchIssue(minimum<512?'error':minimum<1000?'warning':'pass','cover-size',minimum<512?'Cover inférieure à 512 px.':minimum<1000?'Cover valide mais inférieure à 1000 px.':'Cover de dimensions suffisantes.'));try{group.thumbnailResult=await createThumbnailResult(coverFile);group.issues.push(batchIssue('pass','thumbnail-ready','Thumbnail WebP 512 px prête ('+formatBytes(group.thumbnailResult.blob.size)+').'));group.previewUrl=batchRememberObjectUrl(coverFile)}catch(error){group.thumbnailResult=null;group.issues.push(batchIssue('error','thumbnail-failed','La thumbnail ne peut pas être générée : '+error.message))}}}else{group.thumbnailResult=null;group.previewUrl=null}
  if(videoFile){if(group.analysis.video.readable===false)group.issues.push(batchIssue('error','canvas-unreadable','Canvas illisible.'));else if(group.analysis.video.width&&group.analysis.video.height){var ratio=group.analysis.video.width/group.analysis.video.height;var difference=Math.abs(ratio-9/16);group.issues.push(batchIssue(group.analysis.video.height<=group.analysis.video.width||difference>.09?'error':difference>.035?'warning':'pass','canvas-ratio',group.analysis.video.height<=group.analysis.video.width||difference>.09?'Canvas non vertical ou trop éloigné de 9:16.':difference>.035?'Canvas vertical, ratio légèrement éloigné de 9:16.':'Canvas vertical proche de 9:16.'))}}
  return group}

function batchDuplicateSlugs(groups){var counts=new Map();groups.forEach(function(group){counts.set(group.slug,(counts.get(group.slug)||0)+1)});return new Set(Array.from(counts.entries()).filter(function(entry){return entry[1]>1}).map(function(entry){return entry[0]}))}
async function batchAnalyzeAll(){var token=++batchAnalysisToken;batchReleaseObjectUrls();var duplicates=batchDuplicateSlugs(state.batchImport.groups);for(var i=0;i<state.batchImport.groups.length;i++){if(token!==batchAnalysisToken)return;await batchAnalyzeGroup(state.batchImport.groups[i],duplicates)}if(token!==batchAnalysisToken)return;renderBatchImport()}
function batchIssueCounts(group){var counts={error:0,warning:0,info:0,pass:0};(group.issues||[]).forEach(function(issue){counts[issue.level]=(counts[issue.level]||0)+1});return counts}
function batchImportableGroups(){return state.batchImport.groups.filter(function(group){return group.selected&&batchIssueCounts(group).error===0})}
function batchRoleOptions(selected){return ['audio','cover','lyrics','video','ignore'].map(function(role){return '<option value="'+role+'"'+(role===selected?' selected':'')+'>'+BATCH_ROLE_NAMES[role]+'</option>'}).join('')}
function batchRenderIssues(group){var ordered=(group.issues||[]).slice().sort(function(a,b){return {error:0,warning:1,info:2,pass:3}[a.level]-{error:0,warning:1,info:2,pass:3}[b.level]});return ordered.map(function(issue){return '<div class="batch-issue '+issue.level+'"><b>'+batchLevelIcon(issue.level)+'</b><span>'+esc(issue.message)+'</span></div>'}).join('')}
function batchRenderGroup(group,index){var counts=batchIssueCounts(group);var existing=group.existing?'<label class="batch-existing">Track existant<select data-batch-mode="'+index+'"><option value="create"'+(group.mode!=='complete'?' selected':'')+'>Ne pas écraser</option><option value="complete"'+(group.mode==='complete'?' selected':'')+'>Compléter l’existant</option></select></label>':'';var preview=group.previewUrl?'<img src="'+esc(group.previewUrl)+'" alt="">':'<div class="batch-preview-empty">NO COVER</div>';var files=group.files.map(function(entry,fileIndex){return '<div class="batch-file"><div><strong>'+esc(entry.file.name)+'</strong><span>'+formatBytes(entry.file.size)+(entry.file.webkitRelativePath?' · '+esc(entry.file.webkitRelativePath):'')+'</span></div><select data-batch-role="'+index+'" data-file-index="'+fileIndex+'">'+batchRoleOptions(entry.role)+'</select></div>'}).join('');var metadata=Object.keys(group.metadata||{}).length?Object.keys(group.metadata).slice(0,8).map(function(key){return '<span class="chip">'+esc(key)+': '+esc(group.metadata[key])+'</span>'}).join(''):'<span class="sub">Aucune métadonnée TXT reconnue.</span>';return '<article class="batch-group'+(counts.error?' blocked':'')+'" data-batch-group="'+index+'"><div class="batch-group-head"><label class="batch-select"><input type="checkbox" data-batch-selected="'+index+'"'+(group.selected?' checked':'')+'> Inclure</label><span class="quality-state '+(counts.error?'blocked':counts.warning?'review':'ready')+'">'+(counts.error?'Bloqué':counts.warning?'À vérifier':'Prêt')+'</span><button type="button" class="btn small danger" data-batch-remove="'+index+'">Retirer</button></div><div class="batch-group-body"><div class="batch-preview">'+preview+'</div><div class="batch-fields"><label>Titre<input data-batch-title="'+index+'" value="'+esc(group.title)+'"></label><label>Slug<input data-batch-slug="'+index+'" value="'+esc(group.slug)+'"></label>'+existing+'<div class="chips">'+metadata+'</div></div></div><div class="batch-files">'+files+'</div><div class="batch-issues">'+batchRenderIssues(group)+'</div></article>'}
function renderBatchImport(){var groups=state.batchImport.groups;var totalFiles=groups.reduce(function(sum,group){return sum+group.files.length},0);var ready=batchImportableGroups();var blocked=groups.filter(function(group){return group.selected&&batchIssueCounts(group).error>0}).length;$('#batchSummary').innerHTML=groups.length?'<strong>'+groups.length+' morceau(x)</strong><span>'+totalFiles+' fichier(s) · '+ready.length+' prêt(s) · '+blocked+' bloqué(s)</span>':'<strong>Aucun fichier sélectionné</strong><span>Choisis plusieurs fichiers ou un dossier contenant tes morceaux.</span>';$('#batchList').innerHTML=groups.length?groups.map(batchRenderGroup).join(''):'<div class="empty"><strong>Import groupé prêt</strong><span class="sub">Aucun fichier ne sera envoyé avant ta confirmation.</span></div>';$('#batchConfirm').disabled=state.batchImport.busy||!ready.length||blocked>0;$('#batchConfirm').textContent=state.batchImport.busy?'Import en cours…':'Importer '+ready.length+' brouillon(s)'}
async function prepareBatchFiles(files){var merged=batchDedupeFiles(state.batchImport.files.concat(Array.from(files||[])));state.batchImport.files=merged;state.batchImport.groups=batchGroupFiles(merged);renderBatchImport();await batchAnalyzeAll()}
function closeBatchImport(){batchAnalysisToken++;batchReleaseObjectUrls();state.batchImport.files=[];state.batchImport.groups=[];state.batchImport.busy=false;closeModal('batchImportModal');renderBatchImport()}
function openBatchImport(){batchAnalysisToken++;batchReleaseObjectUrls();state.batchImport.files=[];state.batchImport.groups=[];state.batchImport.busy=false;renderBatchImport();openModal('batchImportModal')}
function batchMetadataForUpload(group,existingManifest){var imported=group.metadata||{};var base=existingManifest?Object.assign({},existingManifest,{album:Object.assign({},existingManifest.album||{})}):{slug:group.slug,title:group.title,status:'draft',type:'single',year:null,releaseDate:null,album:{id:'singles',title:'Singles'},genres:[],tags:[],moods:[],themes:[],era:null,energy:null,languages:[],bpm:null,key:null,keyConfidence:null,duration:null,explicit:null,accent:'#1db954',accent2:'#556bff'};var result=Object.assign({},base);result.album=Object.assign({},base.album||{id:'singles',title:'Singles'});result.slug=group.slug;result.title=group.title||batchMetadataValue(imported,'title',batchTitleFromSlug(group.slug));result.type=batchMetadataValue(imported,'type',result.type||'single');result.year=imported.year==null?result.year:Number(imported.year);result.releaseDate=batchMetadataValue(imported,'releaseDate',result.releaseDate||null);result.album.id=batchMetadataValue(imported,'albumId',result.album.id||'singles');result.album.title=batchMetadataValue(imported,'albumTitle',result.album.title||'Singles');result.genres=imported.genres==null?(result.genres||[]):batchListValue(imported.genres);result.tags=result.genres.slice();result.moods=imported.moods==null?(result.moods||[]):batchListValue(imported.moods);result.themes=imported.themes==null?(result.themes||[]):batchListValue(imported.themes);result.era=batchMetadataValue(imported,'era',result.era||null);result.energy=batchMetadataValue(imported,'energy',result.energy||null);result.languages=imported.languages==null?(result.languages||[]):batchListValue(imported.languages);result.bpm=imported.bpm==null?result.bpm:Number(imported.bpm);result.key=batchMetadataValue(imported,'key',result.key||null);result.duration=batchDurationValue(imported.duration);if(result.duration==null&&Number.isFinite(group.analysis.audio&&group.analysis.audio.duration))result.duration=group.analysis.audio.duration;if(result.duration==null)result.duration=base.duration||null;result.explicit=imported.explicit==null?result.explicit:batchParseExplicit(imported.explicit);result.accent=batchMetadataValue(imported,'accent',result.accent||'#1db954');result.accent2=batchMetadataValue(imported,'accent2',result.accent2||'#556bff');result.status=existingManifest?(existingManifest.status||'draft'):'draft';delete result.assets;return result}
function batchQualityEvidence(group){var timestamps=timestampValuesFromText(group.lyricsText||'');return {audio:group.analysis.audio||{},cover:group.analysis.cover||{},thumbnail:group.thumbnailResult?{readable:true,width:512,height:512,size:group.thumbnailResult.blob.size,planned:true}:{},video:group.analysis.video||{},lyrics:group.lyricsText==null?{}:{readable:Boolean(group.lyricsText.trim()),empty:!group.lyricsText.trim(),timestampValues:timestamps,timestampCount:timestamps.length,outOfOrder:timestamps.some(function(value,index){return index>0&&value<timestamps[index-1]}),lastTimestamp:timestamps.length?timestamps[timestamps.length-1]:null}}}
function batchUploadFile(file,role){if(role==='lyrics'&&batchExtension(file.name)==='lrc')return new File([file],batchBaseName(file.name)+'.txt',{type:'text/plain'});return file}
async function batchUploadGroup(group){var existingManifest=null;if(group.existing&&group.mode==='complete'){var existingData=await api('/api/tracks/'+encodeURIComponent(group.slug));existingManifest=existingData.track.manifest}var metadata=batchMetadataForUpload(group,existingManifest);var fd=new FormData();fd.append('metadata',JSON.stringify(metadata));fd.append('qualityEvidence',JSON.stringify(batchQualityEvidence(group)));fd.append('create_only',existingManifest?'false':'true');['audio','cover','lyrics','video'].forEach(function(role){var file=batchRoleFile(group,role);if(file)fd.append(role,batchUploadFile(file,role))});if(group.thumbnailResult)fd.append('thumbnail',new File([group.thumbnailResult.blob],'thumbnail.webp',{type:'image/webp'}));var response=await fetch('/api/tracks/'+encodeURIComponent(group.slug),{method:'PUT',body:fd});var data=await response.json().catch(function(){return {ok:false,error:'Réponse invalide'}});if(!response.ok||!data.ok)throw new Error((data.details||data.error||('HTTP '+response.status))+' ['+group.slug+']');return {created:!existingManifest,slug:group.slug}}
async function startBatchImport(){if(state.batchImport.busy)return;var groups=batchImportableGroups();var blocked=state.batchImport.groups.filter(function(group){return group.selected&&batchIssueCounts(group).error>0});if(blocked.length){showNotice('Corrige les groupes bloqués avant import.',true);return}if(!groups.length){showNotice('Aucun groupe prêt à importer.',true);return}var completions=groups.filter(function(group){return group.existing&&group.mode==='complete'});var confirmation='Importer '+groups.length+' morceau(x) ? Les nouveaux titres seront enregistrés en brouillon.';if(completions.length)confirmation+=' '+completions.length+' track(s) existant(s) seront complétés explicitement et ne pourront pas être restaurés automatiquement.';if(!confirm(confirmation))return;state.batchImport.busy=true;state.running=true;renderBatchImport();var created=[];var completed=[];try{for(var i=0;i<groups.length;i++){showNotice('Import '+(i+1)+'/'+groups.length+' : '+groups[i].title);var result=await batchUploadGroup(groups[i]);if(result.created)created.push(result.slug);else completed.push(result.slug)}showNotice(groups.length+' morceau(x) importé(s) avec thumbnails et métadonnées.');closeBatchImport();await load()}catch(error){var rollbackErrors=[];for(var index=created.length-1;index>=0;index--){try{await api('/api/tracks/'+encodeURIComponent(created[index]),{method:'DELETE'})}catch(rollbackError){rollbackErrors.push(created[index])}}var details=error.message;if(created.length)details+=' · '+(rollbackErrors.length?'Rollback incomplet : '+rollbackErrors.join(', '):'Nouveaux tracks annulés.');if(completed.length)details+=' · Tracks existants déjà modifiés : '+completed.join(', ')+'.';showNotice(details,true);await load()}finally{state.batchImport.busy=false;state.running=false;renderBatchImport()}}
function installBatchImportWorkspace(){var version=document.querySelector('.version-pill');if(version)version.textContent='v4.7';var style=document.createElement('style');style.textContent='.batch-dialog{width:min(1120px,100%)}.batch-intro{display:flex;flex-wrap:wrap;gap:9px;padding:16px 18px;border-bottom:1px solid var(--line)}.batch-drop{flex:1 1 320px;padding:14px;border:1px dashed rgba(125,231,163,.32);border-radius:13px;background:rgba(29,185,84,.035)}.batch-drop strong,.batch-drop span{display:block}.batch-summary{display:flex;justify-content:space-between;gap:14px;padding:14px 18px;border-bottom:1px solid var(--line)}.batch-summary span{color:var(--muted)}.batch-list{display:grid;gap:12px;padding:15px;max-height:62vh;overflow:auto}.batch-group{padding:13px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.02)}.batch-group.blocked{border-color:rgba(255,70,86,.25)}.batch-group-head{display:flex;align-items:center;gap:9px;margin-bottom:11px}.batch-group-head .danger{margin-left:auto}.batch-select{font-weight:800}.batch-group-body{display:grid;grid-template-columns:118px minmax(0,1fr);gap:13px}.batch-preview,.batch-preview img,.batch-preview-empty{width:118px;aspect-ratio:1;border-radius:12px}.batch-preview img{object-fit:cover}.batch-preview-empty{display:grid;place-items:center;background:#202523;color:#607067;font-size:.7rem}.batch-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.batch-fields label,.batch-existing{display:grid;gap:5px;color:#aab6af;font-size:.72rem}.batch-fields input,.batch-fields select,.batch-file select{border:1px solid var(--line);border-radius:9px;padding:8px 9px;background:#171c1a;color:#fff}.batch-fields .chips{grid-column:1/-1}.batch-files{display:grid;gap:7px;margin-top:11px}.batch-file{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:10px;align-items:center;padding:8px 9px;border-radius:10px;background:rgba(0,0,0,.13)}.batch-file strong,.batch-file span{display:block;overflow-wrap:anywhere}.batch-file span{margin-top:2px;color:var(--muted);font-size:.68rem}.batch-issues{display:grid;gap:5px;margin-top:10px}.batch-issue{display:grid;grid-template-columns:22px minmax(0,1fr);gap:6px;padding:6px 8px;border-radius:9px;font-size:.72rem;background:rgba(255,255,255,.025)}.batch-issue.error{color:#ff9aa4}.batch-issue.warning{color:#ffd08a}.batch-issue.pass{color:#89edab}.batch-foot{display:flex;justify-content:flex-end;gap:9px;padding:0 18px 18px}@media(max-width:700px){.batch-group-body{grid-template-columns:78px minmax(0,1fr)}.batch-preview,.batch-preview img,.batch-preview-empty{width:78px}.batch-fields{grid-template-columns:1fr}.batch-fields .chips{grid-column:auto}.batch-file{grid-template-columns:1fr}.batch-summary{flex-direction:column}.batch-foot{flex-wrap:wrap}.batch-foot .btn{flex:1}}';document.head.appendChild(style);var newButton=$('#newTrack');if(newButton&&!$('#batchImport')){var button=document.createElement('button');button.type='button';button.className='btn';button.id='batchImport';button.innerHTML='<span class="btn-icon" aria-hidden="true">⇧</span>Import groupé';newButton.insertAdjacentElement('afterend',button)}var modal=document.createElement('div');modal.className='modal';modal.id='batchImportModal';modal.innerHTML='<div class="dialog batch-dialog"><div class="dialoghead"><h2>Import groupé de fichiers</h2><button type="button" class="btn small" data-batch-close>Fermer</button></div><div class="batch-intro"><div class="batch-drop"><strong>Sélection locale uniquement</strong><span class="sub">Aucun fichier ne part vers R2 avant confirmation.</span></div><button type="button" class="btn" id="batchPickFiles">Choisir des fichiers</button><button type="button" class="btn" id="batchPickFolder">Choisir un dossier</button><input hidden id="batchFiles" type="file" multiple accept="audio/*,image/*,video/mp4,video/webm,.mp3,.wav,.flac,.m4a,.aac,.ogg,.jpg,.jpeg,.png,.webp,.gif,.txt,.lrc,.mp4,.webm"><input hidden id="batchFolder" type="file" multiple webkitdirectory directory></div><div class="batch-summary" id="batchSummary"></div><div class="batch-list" id="batchList"></div><div class="batch-foot"><button type="button" class="btn" data-batch-close>Annuler</button><button type="button" class="btn primary" id="batchConfirm" disabled>Importer</button></div></div>';document.body.appendChild(modal);$('#batchImport').addEventListener('click',openBatchImport);$('#batchPickFiles').addEventListener('click',function(){$('#batchFiles').click()});$('#batchPickFolder').addEventListener('click',function(){$('#batchFolder').click()});$('#batchFiles').addEventListener('change',function(event){prepareBatchFiles(event.target.files);event.target.value=''});$('#batchFolder').addEventListener('change',function(event){prepareBatchFiles(event.target.files);event.target.value=''});$('#batchConfirm').addEventListener('click',startBatchImport);modal.addEventListener('click',function(event){if(event.target.closest('[data-batch-close]')){closeBatchImport();return}var role=event.target.closest('[data-batch-role]');if(role){var group=state.batchImport.groups[Number(role.dataset.batchRole)];var entry=group&&group.files[Number(role.dataset.fileIndex)];if(entry){entry.role=role.value;batchAnalyzeAll()}return}var mode=event.target.closest('[data-batch-mode]');if(mode){var modeGroup=state.batchImport.groups[Number(mode.dataset.batchMode)];if(modeGroup){modeGroup.mode=mode.value;batchAnalyzeAll()}return}var selected=event.target.closest('[data-batch-selected]');if(selected){var selectedGroup=state.batchImport.groups[Number(selected.dataset.batchSelected)];if(selectedGroup){selectedGroup.selected=selected.checked;renderBatchImport()}return}var remove=event.target.closest('[data-batch-remove]');if(remove){state.batchImport.groups.splice(Number(remove.dataset.batchRemove),1);state.batchImport.files=state.batchImport.groups.reduce(function(files,group){return files.concat(group.files.map(function(entry){return entry.file}))},[]);batchAnalyzeAll();return}});modal.addEventListener('change',function(event){var title=event.target.closest('[data-batch-title]');if(title){var group=state.batchImport.groups[Number(title.dataset.batchTitle)];if(group){group.title=title.value.trim()||batchTitleFromSlug(group.slug);renderBatchImport()}return}var slug=event.target.closest('[data-batch-slug]');if(slug){var slugGroup=state.batchImport.groups[Number(slug.dataset.batchSlug)];if(slugGroup){slugGroup.slug=slugifyImportedTitle(slug.value);batchAnalyzeAll()}}});renderBatchImport()}

installBatchImportWorkspace();
