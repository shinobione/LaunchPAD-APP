
function normalizeStudioAlbumTrackIds(value) {
  if (!Array.isArray(value)) throw new Error("INPUT_trackIds doit être un tableau ordonné.");
  const normalized = value.map(trackId => {
    const raw = String(trackId || "").trim();
    const slug = slugify(raw);
    if (!slug || slug !== raw) throw new Error("INPUT_trackId canonique invalide: " + raw + ".");
    return slug;
  });
  if (new Set(normalized).size !== normalized.length) throw new Error("INPUT_trackIds contient des doublons.");
  return normalized;
}

async function canonicalAlbumOwners(env, excludeAlbumId = null) {
  const objects = await listAllObjects(env.MEDIA_BUCKET, ALBUMS_PREFIX);
  const albums = await buildCanonicalAlbumSummaries(objects, env.MEDIA_BUCKET);
  const owners = new Map();
  for (const album of albums) {
    if (album.id === excludeAlbumId) continue;
    for (const trackId of album.trackIds) {
      if (!owners.has(trackId)) owners.set(trackId, []);
      owners.get(trackId).push({ albumId: album.id, title: album.title, updatedAt: album.updatedAt });
    }
  }
  return owners;
}

async function saveStudioAlbumMembership(albumId, request, env, user) {
  const payload = await readStudioAlbumJsonPayload(request, STUDIO_ALBUM_MEMBERSHIP_SAVE_INTENT);
  const existing = await readAlbumManifest(env.MEDIA_BUCKET, albumId);
  if (!existing) return jsonResponse({ ok: false, error: "Album introuvable." }, 404);
  const stale = studioAlbumStaleResponse(existing, payload.expectedUpdatedAt);
  if (stale) return stale;
  const trackIds = normalizeStudioAlbumTrackIds(payload.trackIds);
  const owners = await canonicalAlbumOwners(env, albumId);
  const conflicts = trackIds.flatMap(trackId => (owners.get(trackId) || []).map(owner => ({ trackId, ...owner })));
  if (conflicts.length) {
    return jsonResponse({
      ok: false,
      error: "Un ou plusieurs titres appartiennent déjà à un autre Album canonique.",
      code: "ALBUM_MEMBERSHIP_CONFLICT",
      conflicts,
      currentUpdatedAt: existing.updatedAt || null,
    }, 409);
  }

  const requestedTracks = new Map();
  for (const trackId of trackIds) {
    const track = await readManifest(env.MEDIA_BUCKET, trackId);
    if (!track) return jsonResponse({ ok: false, error: "Titre introuvable: " + trackId + ".", code: "ALBUM_TRACK_MISSING", trackId }, 409);
    requestedTracks.set(trackId, track);
  }

  const proposed = nextAlbumManifest(existing, {}, user, { trackIds });
  const quality = await inspectCanonicalAlbumQuality(env.MEDIA_BUCKET, proposed);
  if (proposed.status === "published" && quality.publishable !== true) {
    return jsonResponse({ ok: false, error: "Tracklist refusée car l'Album publié deviendrait non publiable.", code: "ALBUM_QUALITY_BLOCKED", quality, currentUpdatedAt: existing.updatedAt || null }, 409);
  }

  const previousSet = new Set(existing.trackIds);
  const nextSet = new Set(trackIds);
  const changedTrackIds = [...new Set([...existing.trackIds, ...trackIds])];
  const trackEntries = [];
  for (const trackId of changedTrackIds) {
    const before = requestedTracks.get(trackId) || await readManifest(env.MEDIA_BUCKET, trackId);
    if (!before) continue;
    if (nextSet.has(trackId)) {
      if (before.album?.id !== existing.id || before.album?.title !== proposed.title) {
        trackEntries.push({ id: trackId, before, after: studioAlbumTrackCacheManifest(before, proposed, user) });
      }
      continue;
    }
    if (previousSet.has(trackId) && before.album?.id === existing.id) {
      trackEntries.push({ id: trackId, before, after: studioAlbumSinglesCacheManifest(before, user) });
    }
  }

  let albumWritten = false;
  let tracksWritten = 0;
  try {
    await writeAlbumManifest(env.MEDIA_BUCKET, proposed);
    albumWritten = true;
    for (const entry of trackEntries) {
      await writeManifest(env.MEDIA_BUCKET, entry.after);
      tracksWritten += 1;
    }
    const index = await writeCatalogIndex(env.MEDIA_BUCKET);
    const reread = await readAlbumManifest(env.MEDIA_BUCKET, albumId);
    if (!reread || reread.updatedAt !== proposed.updatedAt || JSON.stringify(reread.trackIds) !== JSON.stringify(trackIds)) {
      throw new Error("SAVE_VERIFY_Tracklist Album non vérifiée.");
    }
    return jsonResponse({
      ok: true,
      saved: true,
      albumId,
      previousUpdatedAt: existing.updatedAt || null,
      updatedAt: reread.updatedAt || null,
      trackIds: reread.trackIds,
      trackCachesUpdated: tracksWritten,
      quality,
      catalogRebuilt: true,
      catalogGeneratedAt: index.generatedAt || null,
      albumCount: index.albumCount || 0,
      authenticatedEmail: user.email || null,
    });
  } catch (error) {
    const rollback = await rollbackAlbumManifestAndTracks(
      env.MEDIA_BUCKET,
      albumWritten ? [{ id: albumId, before: existing }] : [],
      trackEntries.slice(0, tracksWritten),
    );
    console.error("Album membership save failed", error);
    return jsonResponse({ ok: false, error: "Tracklist Album annulée après échec de publication ou vérification.", code: "ALBUM_MEMBERSHIP_ROLLBACK", rollback, currentUpdatedAt: existing.updatedAt || null }, 500);
  }
}

function studioAlbumInsertAt(trackIds, trackId, indexValue) {
  const next = trackIds.filter(value => value !== trackId);
  const requestedIndex = Number(indexValue);
  const index = Number.isInteger(requestedIndex) ? Math.max(0, Math.min(requestedIndex, next.length)) : next.length;
  next.splice(index, 0, trackId);
  return next;
}

async function moveStudioAlbumTrack(targetAlbumId, request, env, user) {
  const payload = await readStudioAlbumJsonPayload(request, STUDIO_ALBUM_TRACK_MOVE_INTENT);
  const trackId = String(payload.trackId || "").trim();
  if (!trackId || slugify(trackId) !== trackId) throw new Error("INPUT_trackId canonique invalide.");
  const sourceAlbumId = payload.sourceAlbumId == null || payload.sourceAlbumId === "" ? null : String(payload.sourceAlbumId).trim();
  if (sourceAlbumId && slugify(sourceAlbumId) !== sourceAlbumId) throw new Error("INPUT_sourceAlbumId canonique invalide.");

  const target = await readAlbumManifest(env.MEDIA_BUCKET, targetAlbumId);
  if (!target) return jsonResponse({ ok: false, error: "Album cible introuvable." }, 404);
  const targetStale = studioAlbumStaleResponse(target, payload.expectedTargetUpdatedAt || payload.expectedUpdatedAt, "STALE_TARGET_ALBUM");
  if (targetStale) return targetStale;

  const track = await readManifest(env.MEDIA_BUCKET, trackId);
  if (!track) return jsonResponse({ ok: false, error: "Titre introuvable.", code: "ALBUM_TRACK_MISSING", trackId }, 404);

  let source = null;
  if (sourceAlbumId && sourceAlbumId !== targetAlbumId) {
    source = await readAlbumManifest(env.MEDIA_BUCKET, sourceAlbumId);
    if (!source) return jsonResponse({ ok: false, error: "Album source introuvable.", code: "SOURCE_ALBUM_MISSING" }, 409);
    const sourceStale = studioAlbumStaleResponse(source, payload.expectedSourceUpdatedAt, "STALE_SOURCE_ALBUM");
    if (sourceStale) return sourceStale;
    if (!source.trackIds.includes(trackId)) return jsonResponse({ ok: false, error: "Le titre n'appartient pas à l'Album source.", code: "SOURCE_MEMBERSHIP_MISMATCH" }, 409);
  }

  const owners = await canonicalAlbumOwners(env, targetAlbumId);
  const otherOwners = (owners.get(trackId) || []).filter(owner => !source || owner.albumId !== source.id);
  if (otherOwners.length) {
    return jsonResponse({ ok: false, error: "Le titre appartient déjà à un autre Album canonique.", code: "ALBUM_MEMBERSHIP_CONFLICT", conflicts: otherOwners.map(owner => ({ trackId, ...owner })) }, 409);
  }

  const targetTrackIds = studioAlbumInsertAt(target.trackIds, trackId, payload.targetIndex);
  const proposedTarget = nextAlbumManifest(target, {}, user, { trackIds: targetTrackIds });
  const proposedSource = source ? nextAlbumManifest(source, {}, user, { trackIds: source.trackIds.filter(value => value !== trackId) }) : null;
  const [targetQuality, sourceQuality] = await Promise.all([
    inspectCanonicalAlbumQuality(env.MEDIA_BUCKET, proposedTarget),
    proposedSource ? inspectCanonicalAlbumQuality(env.MEDIA_BUCKET, proposedSource) : Promise.resolve(null),
  ]);
  if (proposedTarget.status === "published" && targetQuality.publishable !== true) {
    return jsonResponse({ ok: false, error: "Déplacement refusé car l'Album cible publié deviendrait non publiable.", code: "ALBUM_QUALITY_BLOCKED", albumId: target.id, quality: targetQuality }, 409);
  }
  if (proposedSource?.status === "published" && sourceQuality?.publishable !== true) {
    return jsonResponse({ ok: false, error: "Déplacement refusé car l'Album source publié deviendrait non publiable.", code: "ALBUM_QUALITY_BLOCKED", albumId: source.id, quality: sourceQuality }, 409);
  }

  const trackAfter = studioAlbumTrackCacheManifest(track, proposedTarget, user);
  const albumEntries = [{ id: target.id, before: target, after: proposedTarget }];
  if (source && source.id !== target.id) albumEntries.unshift({ id: source.id, before: source, after: proposedSource });
  let albumsWritten = 0;
  let trackWritten = false;
  try {
    for (const entry of albumEntries) {
      await writeAlbumManifest(env.MEDIA_BUCKET, entry.after);
      albumsWritten += 1;
    }
    await writeManifest(env.MEDIA_BUCKET, trackAfter);
    trackWritten = true;
    const index = await writeCatalogIndex(env.MEDIA_BUCKET);
    const [targetReread, sourceReread, trackReread] = await Promise.all([
      readAlbumManifest(env.MEDIA_BUCKET, target.id),
      source ? readAlbumManifest(env.MEDIA_BUCKET, source.id) : Promise.resolve(null),
      readManifest(env.MEDIA_BUCKET, trackId),
    ]);
    if (!targetReread || !targetReread.trackIds.includes(trackId) || trackReread?.album?.id !== target.id) {
      throw new Error("SAVE_VERIFY_Déplacement Album non vérifié.");
    }
    if (sourceReread?.trackIds.includes(trackId)) throw new Error("SAVE_VERIFY_Album source contient encore le titre déplacé.");
    return jsonResponse({
      ok: true,
      moved: true,
      trackId,
      sourceAlbumId: source?.id || null,
      targetAlbumId: target.id,
      targetTrackIds: targetReread.trackIds,
      sourceTrackIds: sourceReread?.trackIds || null,
      targetUpdatedAt: targetReread.updatedAt || null,
      sourceUpdatedAt: sourceReread?.updatedAt || null,
      quality: { target: targetQuality, source: sourceQuality },
      catalogRebuilt: true,
      catalogGeneratedAt: index.generatedAt || null,
      albumCount: index.albumCount || 0,
      authenticatedEmail: user.email || null,
    });
  } catch (error) {
    const rollback = await rollbackAlbumManifestAndTracks(
      env.MEDIA_BUCKET,
      albumEntries.slice(0, albumsWritten).map(entry => ({ id: entry.id, before: entry.before })),
      trackWritten ? [{ id: trackId, before: track }] : [],
    );
    console.error("Album track move failed", error);
    return jsonResponse({ ok: false, error: "Déplacement Album annulé après échec de publication ou vérification.", code: "ALBUM_MOVE_ROLLBACK", rollback }, 500);
  }
}
