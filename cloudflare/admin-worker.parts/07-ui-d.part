eight=source.height||source.naturalHeight;var scale=Math.max(size/width,size/height);var drawWidth=width*scale;var drawHeight=height*scale;ctx.drawImage(source,(size-drawWidth)/2,(size-drawHeight)/2,drawWidth,drawHeight);if(source.close)source.close();return new Promise(function(resolve,reject){canvas.toBlob(function(result){result?resolve(result):reject(new Error('Impossible de créer la miniature.'))},'image/webp',.82)})}
async function save(ev){ev.preventDefault();var f=$('#trackForm');var slug=f.elements.slug.value.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');if(!slug){showNotice('Slug invalide.',true);return}var n=function(name){var v=f.elements[name].value;return v===''?null:Number(v)};var explicit=f.elements.explicit.value==='null'?null:f.elements.explicit.value==='true';var meta={slug:slug,title:f.elements.title.value.trim(),status:f.elements.status.value,type:f.elements.type.value,year:n('year'),releaseDate:f.elements.releaseDate.value||null,album:{id:f.elements.albumId.value.trim()||'singles',title:f.elements.albumTitle.value.trim()||'Singles'},genres:split(f.elements.genres.value),tags:split(f.elements.genres.value),moods:split(f.elements.moods.value),themes:split(f.elements.themes.value),era:f.elements.era.value.trim()||null,energy:f.elements.energy.value.trim()||null,languages:split(f.elements.languages.value),bpm:n('bpm'),key:f.elements.key.value.trim()||null,keyConfidence:n('keyConfidence'),duration:n('duration'),explicit:explicit,accent:f.elements.accent.value,accent2:f.elements.accent2.value};var fd=new FormData();fd.append('metadata',JSON.stringify(meta));['audio','cover','lyrics','video'].forEach(function(k){var file=f.elements[k].files[0];if(file)fd.append(k,file)});var coverFile=f.elements.cover.files[0];if(coverFile){try{var thumbnail=await createThumbnailBlob(coverFile);fd.append('thumbnail',new File([thumbnail],'thumbnail.webp',{type:'image/webp'}))}catch(e){showNotice('Miniature non générée : '+e.message,true)}}$('#saveTrack').disabled=true;fetch('/api/tracks/'+encodeURIComponent(slug),{method:'PUT',body:fd}).then(async function(r){var data=await r.json();if(!r.ok||!data.ok)throw new Error(data.details||data.error);closeModal('editorModal');showNotice('Titre enregistré.');return load()}).catch(function(e){showNotice(e.message,true)}).finally(function(){$('#saveTrack').disabled=false})}
function remove(slug){if(!confirm('Supprimer définitivement '+slug+' et tous ses fichiers R2 ?'))return;api('/api/tracks/'+encodeURIComponent(slug),{method:'DELETE'}).then(function(){showNotice('Titre supprimé.');load()}).catch(function(e){showNotice(e.message,true)})}
function migrateLegacy(slug){var path=slug?'/api/import/legacy/'+encodeURIComponent(slug):'/api/import/legacy';api(path,{method:'POST'}).then(function(){showNotice('Fichiers legacy rangés et ancienne structure supprimée.');load()}).catch(function(e){showNotice(e.message,true)})}
function prepareMigration(){api('/api/migration-plan').then(function(data){state.plan=data.plan;renderMigration();openModal('migrationModal')}).catch(function(e){showNotice(e.message,true)})}
function renderMigration(){var existing=new Set(state.tracks.map(function(t){return t.slug}));$('#migrationList').innerHTML=state.plan.tracks.map(function(t){var done=existing.has(t.slug);return '<div class="migrationrow" data-migrate-row="'+esc(t.slug)+'"><div><strong>'+esc(t.title)+'</strong><div class="sub">'+esc(t.album&&t.album.title||'Singles')+'</div></div><span class="state">'+(done?'Déjà dans R2':'À importer')+'</span></div>'}).join('');$('#migrationBar').style.width='0%'}
async function startMigration(){if(state.running||!state.plan)return;state.running=true;$('#startMigration').disabled=true;var existing=new Set(state.tracks.map(function(t){return t.slug}));var pending=state.plan.tracks.filter(function(t){return !existing.has(t.slug)});var done=0;for(var i=0;i<pending.length;i++){var t=pending[i];var row=document.querySelector('[data-migrate-row="'+CSS.escape(t.slug)+'"] .state');row.textContent='Import en cours…';try{await api('/api/import/github/'+encodeURIComponent(t.slug),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({overwrite:false})});row.textContent='Importé';row.style.color='#7de7a3'}catch(e){row.textContent='Erreur : '+e.message;row.style.color='#ff9aa4';state.running=false;$('#startMigration').disabled=false;showNotice('Migration interrompue sur '+t.title+' : '+e.message,true);await load();return}done++;$('#migrationBar').style.width=(done/Math.max(1,pending.length)*100)+'%'}state.running=false;$('#startMigration').disabled=false;showNotice('Migration GitHub terminée.');await load()}
async function optimizeAllCovers(){if(state.running)return;var pending=state.tracks.filter(function(t){return t.assets.cover&&t.assets.cover.present&&!(t.assets.thumbnail&&t.assets.thumbnail.present)});if(!pending.length){showNotice('Toutes les covers sont déjà optimisées.');return}state.running=true;$('#optimizeCovers').disabled=true;var done=0;for(var i=0;i<pending.length;i++){var track=pending[i];showNotice('Optimisation '+(i+1)+'/'+pending.length+' : '+track.title);try{var response=await fetch('/api/media/'+encodeURIComponent(track.slug)+'/cover',{cache:'no-store'});if(!response.ok)throw new Error('Pochette inaccessible');var source=await response.blob();var thumbnail=await createThumbnailBlob(source);var upload=await fetch('/api/tracks/'+encodeURIComponent(track.slug)+'/thumbnail?defer=1',{method:'PUT',headers:{'Content-Type':'image/webp'},body:thumbnail});var data=await upload.json().catch(function(){return {ok:false,error:'Réponse invalide'}});if(!upload.ok||!data.ok)throw new Error(data.details||data.error||('HTTP '+upload.status));done++}catch(e){state.running=false;$('#optimizeCovers').disabled=false;showNotice('Échec sur '+track.title+' : '+e.message,true);await load();return}}try{await api('/api/catalog/rebuild',{method:'POST'});showNotice(done+' covers optimisées et index public reconstruit.');await load()}catch(e){showNotice('Miniatures créées, mais index non reconstruit : '+e.message,true)}finally{state.running=false;$('#optimizeCovers').disabled=false}}
document.addEventListener('click',function(e){var c=e.target.closest('[data-close]');if(c)closeModal(c.dataset.close);var ed=e.target.closest('[data-edit]');if(ed)edit(ed.dataset.edit);var del=e.target.closest('[data-delete]');if(del)remove(del.dataset.delete);var leg=e.target.closest('[data-legacy]');if(leg)migrateLegacy(l