eg.dataset.legacy)});
var THUMBNAIL_PIPELINE_VERSION='v2';
var THUMBNAIL_SIZE=512;
var THUMBNAIL_RENDER_SIZE=1024;
var THUMBNAIL_TARGET_BYTES=180*1024;
var THUMBNAIL_QUALITY_STEPS=[.9,.86,.82,.78,.74,.7];
function thumbnailCanvasToBlob(canvas,quality){return new Promise(function(resolve,reject){canvas.toBlob(function(result){if(!result){reject(new Error('Impossible de créer la miniature.'));return}if(result.type!=='image/webp'){reject(new Error('Ce navigateur ne peut pas encoder les miniatures WebP.'));return}resolve(result)},'image/webp',quality)})}
function thumbnailImageSize(source){return {width:Number(source.width||source.naturalWidth||0),height:Number(source.height||source.naturalHeight||0)}}
function drawThumbnailArtwork(ctx,source,width,height,size){ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';var ratio=width/height;var squareEnough=ratio>=.9&&ratio<=1.1;if(squareEnough){ctx.fillStyle='#05030b';ctx.fillRect(0,0,size,size);var cropScale=Math.max(size/width,size/height);var cropWidth=width*cropScale;var cropHeight=height*cropScale;ctx.drawImage(source,(size-cropWidth)/2,(size-cropHeight)/2,cropWidth,cropHeight);return 'crop'}var backgroundScale=Math.max((size+96)/width,(size+96)/height);var backgroundWidth=width*backgroundScale;var backgroundHeight=height*backgroundScale;ctx.save();ctx.filter='blur(42px) saturate(1.12) brightness(.58)';ctx.drawImage(source,(size-backgroundWidth)/2,(size-backgroundHeight)/2,backgroundWidth,backgroundHeight);ctx.restore();ctx.fillStyle='rgba(5,3,11,.24)';ctx.fillRect(0,0,size,size);var margin=64;var foregroundScale=Math.min((size-margin*2)/width,(size-margin*2)/height);var foregroundWidth=width*foregroundScale;var foregroundHeight=height*foregroundScale;ctx.save();ctx.shadowColor='rgba(0,0,0,.48)';ctx.shadowBlur=34;ctx.shadowOffsetY=16;ctx.drawImage(source,(size-foregroundWidth)/2,(size-foregroundHeight)/2,foregroundWidth,foregroundHeight);ctx.restore();return 'framed'}
async function createThumbnailResult(blob){var source=await loadImageSource(blob);try{var dimensions=thumbnailImageSize(source);var width=dimensions.width;var height=dimensions.height;if(!Number.isFinite(width)||!Number.isFinite(height)||width<64||height<64)throw new Error('La pochette est trop petite ou illisible.');if(width*height>100000000)throw new Error('La pochette dépasse 100 mégapixels.');var renderCanvas=document.createElement('canvas');renderCanvas.width=THUMBNAIL_RENDER_SIZE;renderCanvas.height=THUMBNAIL_RENDER_SIZE;var renderContext=renderCanvas.getContext('2d',{alpha:false});if(!renderContext)throw new Error('Canvas indisponible.');var mode=drawThumbnailArtwork(renderContext,source,width,height,THUMBNAIL_RENDER_SIZE);var finalCanvas=document.createElement('canvas');finalCanvas.width=THUMBNAIL_SIZE;finalCanvas.height=THUMBNAIL_SIZE;var finalContext=finalCanvas.getContext('2d',{alpha:false});if(!finalContext)throw new Error('Canvas indisponible.');finalContext.imageSmoothingEnabled=true;finalContext.imageSmoothingQuality='high';finalContext.drawImage(renderCanvas,0,0,THUMBNAIL_SIZE,THUMBNAIL_SIZE);var selected=null;var selectedQuality=THUMBNAIL_QUALITY_STEPS[THUMBNAIL_QUALITY_STEPS.length-1];for(var i=0;i<THUMBNAIL_QUALITY_STEPS.length;i++){var quality=THUMBNAIL_QUALITY_STEPS[i];selected=await thumbnailCanvasToBlob(finalCanvas,quality);selectedQuality=quality;if(selected.size<=THUMBNAIL_TARGET_BYTES)break}return {blob:selected,mode:mode,quality:selectedQuality,width:width,height:height,pipeline:THUMBNAIL_PIPELINE_VERSION}}finally{if(source&&source.close)source.close()}}
createThumbnailBlob=async function(blob){return (await createThumbnailResult(blob)).blob};
optimizeAllCovers=async function(){if(state.running)return;var available=state.tracks.filter(function(track){return track.assets.cover&&track.assets.cover.present});if(!available.length){showNotice('Aucune cover à optimiser.',true);return}var missing=available.filter(function(track){return !(track.assets.thumbnail&&track.assets.thumbnail.present)});var pending=missing;if(!missing.length){if(!confirm('Toutes les covers ont déjà une miniature. Régénérer les '+available.length+' miniatures avec le pipeline '+THUMBNAIL_PIPELINE_VERSION+' ?'))return;pending=available}else if(available.length>missing.length&&confirm(missing.length+' cover(s) n’ont pas de miniature. Régénérer aussi les '+(available.length-missing.length)+' miniatures existantes avec le pipeline '+THUMBNAIL_PIPELINE_VERSION+' ?')){pending=available}state.running=true;$('#optimizeCovers').disabled=true;var done=0;var totalBytes=0;var framed=0;try{for(var i=0;i<pending.length;i++){var track=pending[i];showNotice('Optimisation '+(i+1)+'/'+pending.length+' : '+track.title);var response=await fetch('/api/media/'+encodeURIComponent(track.slug)+'/cover',{cache:'no-store'});if(!response.ok)throw new Error('Pochette inaccessible');var source=await response.blob();var result=await createThumbnailResult(source);var upload=await fetch('/api/tracks/'+encodeURIComponent(track.slug)+'/thumbnail?defer=1',{method:'PUT',headers:{'Content-Type':result.blob.type},body:result.blob});var data=await upload.json().catch(function(){return {ok:false,error:'Réponse invalide'}});if(!upload.ok||!data.ok)throw new Error(data.details||data.error||('HTTP '+upload.status));done++;totalBytes+=result.blob.size;if(result.mode==='framed')framed++}await api('/api/catalog/rebuild',{method:'POST'});showNotice(done+' miniatures '+THUMBNAIL_PIPELINE_VERSION+' créées ('+formatBytes(totalBytes)+', '+framed+' cadrage(s) préservé(s)).');await load()}catch(e){showNotice('Échec après '+done+' miniature(s) : '+e.message,true);await load()}finally{state.running=false;$('#optimizeCovers').disabled=false}};
var optimizeButton=$('#optimizeCovers');optimizeButton.innerHTML='<span class="btn-icon" aria-hidden="true">◇</span>Optimiser les miniatures';optimizeButton.title='Créer ou régénérer des miniatures WebP 512 px avec le pipeline '+THUMBNAIL_PIPELINE_VERSION;
var TXT_METADATA_FIELD_MAP={TITLE:'title',TITRE:'title',TYPE:'type',YEAR:'year',ANNEE:'year',GENRE:'genres',GENRES:'genres',TAG:'genres',TAGS:'genres',MOOD:'moods',MOODS:'moods',THEME:'themes',THEMES:'themes',ERA:'era',ERE:'era',ENERGY:'energy',ENERGIE:'energy',LANGUAGE:'languages',LANGUAGES:'languages',LANGUE:'languages',LANGUES:'languages',STATUS:'status',STATUT:'status',RELEASE_DATE:'releaseDate',DATE_DE_SORTIE:'releaseDate',ALBUM:'albumTitle',ALBUM_TITLE:'albumTitle',NOM_ALBUM:'albumTitle',ALBUM_ID:'albumId',ID_ALBUM:'albumId',BPM:'bpm',KEY:'key',TONALITE:'key',DURATION:'duration',DUREE:'duration',EXPLICIT:'explicit',ACCENT:'accent',ACCENT_2:'accent2'};
function normalizeTxtMetadataKey(value){return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase().replace(/[^A-Z0-9]+/g,'_').replace(/^_|_$/g,'')}
function normalizeTxtMetadataValue(field,value){var clean=String(value||'').trim();if(!clean)return null;if(field==='genres'||field==='moods'||field==='themes'||field==='languages')return split(clean).join(', ');if(field==='year'){var year=Number.parseInt(clean,10);return year>=1900&&year<=2200?String(year):null}if(field==='bpm'){var bpm=Number(clean);return Number.isFinite(bpm)&&bpm>0&&bpm<400?String(bpm):null}if(field==='type'){var type=normalizeTxtMetadataKey(clean).toLowerCase();return type==='single'?'single':type==='album_track'||type==='albumtrack'?'album-track':type==='demo'?'demo':null}if(field==='status'){var status=clean.toLowerCase();return ['draft','published','archived'].includes(status)?status:null}if(field==='explicit'){var explicit=clean.toLowerCase();if(['true','yes','oui','explicit'].includes(explicit))return 'true';if(['false','no','non','clean'].includes(explicit))return 'false';return null}if(field==='releaseDate')return /^\d{4}-\d{2}-\d{2}$/.test(clean)?clean:null;if(field==='duration')return /^(?:\d+:)?[0-5]\d(?:\.\d{1,3})?$/.test(clean)?clean:null;if(field==='accent'||field==='accent2')return /^#[0-9a-f]{6}$/i.test(clean)?clean:null;return clean}
function parseLyricsTxtMetadata(text){var lines=String(text||'').replace(/^\uFEFF/,'').split(/\r?\n/);var metadata={};var lyricsStart=-1;for(var i=0;i<lines.length;i++){var line=lines[i].trim();if(/^LYRICS\s*:?\s*$/i.test(line)){lyricsStart=i+1;break}var match=line.match(/^([A-Za-zÀ-ÿ][A-Za-zÀ-ÿ0-9 _-]{0,60})\s*:\s*(.+)$/);if(!match)continue;var field=TXT_METADATA_FIELD_MAP[normalizeTxtMetadataKey(match[1])];if(!field)continue;var value=normalizeTxtMetadataValue(field,match[2]);if(value==null)continue;if(['genres','moods','themes','languages'].includes(field)&&metadata[field])metadata[field]=split(metadata[field]+','+value).filter(function(item,index,array){return array.findIndex(function(candidate){return candidate.toLowerCase()===item.toLowerCase()})===index}).join(', ');else metadata[field]=value}var timestampCount=lyricsStart<0?0:lines.slice(lyricsStart).filter(function(line){return /^\[\d{1,3}:\d{2}(?:[.:]\d{1,3})?\]/.test(line.trim())}).length;return {metadata:metadata,lyricsFound:lyricsStart>=0,timestampCount:timestampCount}}
function slugifyImportedTitle(value){return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,120)}
function applyLyricsTxtMetadata(result){var form=$('#trackForm');var filled=[];var kept=[];var defaults={type:'single',status:'draft',explicit:'null',albumId:'singles',albumTitle:'Singles'};Object.keys(result.metadata).forEach(function(field){var input=form.elements[field];if(!input)return;var value=result.metadata[field];var current=String(input.value||'').trim();var canReplaceDefault=!state.editing&&Object.prototype.hasOwnProperty.call(defaults,field)&&current===defaults[field];if(!current||canReplaceDefault){input.value=value;filled.push(field)}else if(current.toLowerCase()!==String(value).toLowerCase())kept.push(field)});if(result.metadata.title&&form.elements.slug&&!form.elements.slug.readOnly&&!form.elements.slug.value.trim()){form.elements.slug.value=slugifyImportedTitle(result.metadata.title);filled.push('slug')}var parts=['✓ '+Object.keys(result.metadata).length+' métadonnée(s) détectée(s)',filled.length+' champ(s) rempli(s)'];if(kept.length)parts.push(kept.length+' valeur(s) existante(s) conservée(s)');if(result.timestampCount)parts.push(result.timestampCount+' ligne(s) timestampée(s)');if(!result.lyricsFound)parts.push('bloc LYRICS: absent');$('#currentLyrics').textContent=parts.join(' · ');showNotice('Métadonnées du TXT importées dans le formulaire.');scheduleQualityCheck()}
async function importLyricsTxtFile(event){var file=event.target.files&&event.target.files[0];if(!file)return;try{var result=parseLyricsTxtMetadata(await file.text());if(!Object.keys(result.metadata).length){$('#currentLyrics').textContent='Aucune métadonnée reconnue avant LYRICS:.';scheduleQualityCheck();return}applyLyricsTxtMetadata(result)}catch(error){$('#currentLyrics').textContent='Import TXT impossible : '+error.message;showNotice('Impossible de lire les métadonnées du fichier Lyrics.',true)}}

var QUALITY_MEDIA_TIMEOUT=10000;
var qualityTimer=0;
state.currentTrackData=null;
state.qualityReport=null;
state.qualityChecking=false;

function installQualityWorkspace(){
  var version=document.querySelector('.version-pill');if(version)version.textContent='v4.6';
  var style=document.createElement('style');style.textContent='.quality-panel{margin:0 18px 18px;padding:15px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(145deg,rgba(125,130,255,.07),rgba(29,185,84,.035))}.quality-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.quality-head h3{margin:3px 0 4px;font-size:.96rem}.quality-state{display:inline-flex;align-items:center;border-radius:999px;padding:6px 9px;font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.06em}.quality-state.ready{color:#89edab;background:rgba(29,185,84,.12)}.quality-state.review{color:#ffd08a;background:rgba(255,174,54,.11)}.quality-state.blocked{color:#ff9aa4;background:rgba(255,70,86,.12)}.quality-counts{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}.quality-count{padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.045);font-size:.7rem}.quality-list{display:grid;gap:7px;max-height:285px;overflow:auto}.quality-item{display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;padding:8px 9px;border:1px solid rgba(255,255,255,.055);border-radius:10px;background:rgba(0,0,0,.12)}.quality-item strong{display:block;font-size:.75rem}.quality-item span{display:block;margin-top:2px;color:var(--muted);font-size:.71rem;line-height:1.35}.quality-item.error{border-color:rgba(255,70,86,.2)}.quality-item.warning{border-color:rgba(255,174,54,.17)}.quality-empty{color:var(--muted);font-size:.76rem}.quality-actions{display:flex;gap:8px;align-items:center;margin-right:auto}.track-quality{display:inline-flex;gap:4px}.track-quality .chip.error{color:#ff9aa4;background:rgba(255,70,86,.1)}@media(max-width:700px){.quality-panel{margin:0 10px 12px}.quality-head{align-items:stretch;flex-direction:column}.quality-actions{width:100%;margin:0}.quality-actions .btn{flex:1}.dialogfoot{flex-wrap:wrap}}';document.head.appendChild(style);
  var foot=document.querySelector('#trackForm .dialogfoot');
  if(foot&&!document.querySelector('#qualityCheck')){var actions=document.createElement('div');actions.className='quality-actions';actions.innerHTML='<button type="button" class="btn" id="qualityCheck">Contrôler</button><span class="sub" id="qualityHint">Contrôle local + R2</span>';foot.prepend(actions)}
  var panel=document.createElement('section');panel.id='qualityPanel';panel.className='quality-panel';panel.setAttribute('aria-live','polite');panel.innerHTML='<div class="quality-head"><div><div class="eyebrow">Contrôle avant publication</div><h3>Qualité du morceau</h3><div class="sub" id="qualitySubtitle">Aucun contrôle lancé.</div></div><span class="quality-state review" id="qualityState">À contrôler</span></div><div class="quality-counts" id="qualityCounts"></div><div class="quality-list" id="qualityList"><div class="quality-empty">Les erreurs bloquent uniquement la publication. Les brouillons restent enregistrables.</div></div>';
  if(foot&&!document.querySelector('#qualityPanel'))foot.parentNode.insertBefore(panel,foot);
  updateSaveButtonLabel();
}

function qualityLevelIcon(level){return level==='pass'?'✓':level==='error'?'✕':level==='warning'?'⚠':'i'}
function reportFromItems(items,source){var counts={error:0,warning:0,info:0,pass:0};items.forEach(function(item){counts[item.level]=(counts[item.level]||0)+1});return {schemaVersion:1,checkedAt:new Date().toISOString(),source:source||'browser',items:items,counts:counts,publishable:counts.error===0,state:counts.error?'blocked':counts.warning?'review':'ready'}}
function renderQuality(report){state.qualityReport=report||null;var panel=$('#qualityPanel');if(!panel)return;if(!report){$('#qualityState').className='quality-state review';$('#qualityState').textContent='À contrôler';$('#qualitySubtitle').textContent='Aucun contrôle lancé.';$('#qualityCounts').innerHTML='';$('#qualityList').innerHTML='<div class="quality-empty">Les erreurs bloquent uniquement la publication. Les brouillons restent enregistrables.</div>';return}var counts=report.counts||{error:0,warning:0,info:0,pass:0};$('#qualityState').className='quality-state '+report.state;$('#qualityState').textContent=report.state==='ready'?'Prêt':report.state==='blocked'?'Bloqué':'À vérifier';$('#qualitySubtitle').textContent=(report.source==='r2'?'Audit R2':'Précontrôle navigateur')+' · '+new Date(report.checkedAt||Date.now()).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});$('#qualityCounts').innerHTML='<span class="quality-count">✓ '+(counts.pass||0)+' validé(s)</span><span class="quality-count">⚠ '+(counts.warning||0)+' avertissement(s)</span><span class="quality-count">✕ '+(counts.error||0)+' erreur(s)</span><span class="quality-count">i '+(counts.info||0)+' information(s)</span>';var ordered=(report.items||[]).slice().sort(function(a,b){return {error:0,warning:1,info:2,pass:3}[a.level]-{error:0,warning:1,info:2,pass:3}[b.level]});$('#qualityList').innerHTML=ordered.length?ordered.map(function(item){return '<div class="quality-item '+esc(item.level)+'"><b aria-hidden="true">'+qualityLevelIcon(item.level)+'</b><div><strong>'+esc(item.label||item.code)+'</strong><span>'+esc(item.message||'')+'</span></div></div>'}).join(''):'<div class="quality-empty">Aucun problème détecté.</div>'}
function qualityItemClient(level,code,label,message,details){return Object.assign({level:level,code:code,label:label,message:message},details||{})}
function currentAssetPresent(kind){var asset=state.currentTrackData&&state.currentTrackData.assets&&state.currentTrackData.assets[kind];return Boolean(asset&&asset.present)}
function selectedFile(kind){return $('#trackForm').elements[kind].files&&$('#trackForm').elements[kind].files[0]||null}
function mediaUrl(kind){if(!state.editing||!currentAssetPresent(kind))return null;return '/api/media/'+encodeURIComponent(state.editing)+'/'+kind+'?quality='+Date.now()}
function sourceForKind(kind){var file=selectedFile(kind);if(file)return {url:URL.createObjectURL(file),revoke:true,file:file};var url=mediaUrl(kind);return url?{url:url,revoke:false,file:null}:null}
function timeoutPromise(message){return new Promise(function(_,reject){setTimeout(function(){reject(new Error(message))},QUALITY_MEDIA_TIMEOUT)})}
function inspectImageSource(kind){var source=sourceForKind(kind);if(!source)return Promise.resolve(null);return Promise.race([new Promise(function(resolve,reject){var image=new Image();image.onload=function(){resolve({readable:true,width:image.naturalWidth,height:image.naturalHeight,size:source.file&&source.file.size||null})};image.onerror=function(){reject(new Error('Image illisible.'))};image.src=source.url}),timeoutPromise('Lecture image trop longue.')]).catch(function(){return {readable:false}}).finally(function(){if(source.revoke)URL.revokeObjectURL(source.url)})}
function inspectTimedMedia(kind){var source=sourceForKind(kind);if(!source)return Promise.resolve(null);return Promise.race([new Promise(function(resolve,reject){var media=document.createElement(kind==='audio'?'audio':'video');media.preload='metadata';media.muted=true;media.onloadedmetadata=function(){resolve({readable:true,duration:Number.isFinite(media.duration)?media.duration:null,width:kind==='video'?media.videoWidth:null,height:kind==='video'?media.videoHeight:null,size:source.file&&source.file.size||null})};media.onerror=function(){reject(new Error('Média illisible.'))};media.src=source.url;media.load()}),timeoutPromise('Lecture média trop longue.')]).catch(function(){return {readable:false}}).finally(function(){if(source.revoke)URL.revokeObjectURL(source.url)})}
function timestampValuesFromText(text){var normalized=String(text||'').replace(/^\uFEFF/,'').replace(/\r\n?/g,'\n');var marker=normalized.match(/^LYRICS\s*:\s*$/im);if(marker)normalized=normalized.slice(marker.index+marker[0].length);var values=[];normalized.split('\n').forEach(function(sourceLine){var line=sourceLine.trim();if(!line)return;var bracket=/\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]/g;var matches=Array.from(line.matchAll(bracket));if(matches.length){matches.forEach(function(match){values.push(Number(match[1])*60+Number(match[2])+Number('0.'+String(match[3]||'0').padEnd(3,'0').slice(0,3)))});return}var naked=line.match(/^(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?(?:\s+.*)?$/);if(naked)values.push(Number(naked[1])*60+Number(naked[2])+Number('0.'+String(naked[3]||'0').padEnd(3,'0').slice(0,3))) });return values}
async function inspectLyricsSource(){var file=selectedFile('lyrics');var text=null;if(file)text=await file.text();else if(state.editing&&currentAssetPresent('lyrics')){var response=await fetch(mediaUrl('lyrics'),{cache:'no-store'});if(!response.ok)return {readable:false};text=await response.text()}if(text==null)return null;var timestamps=timestampValuesFromText(text);return {readable:Boolean(text.trim()),empty:!text.trim(),timestampValues:timestamps,timestampCount:timestamps.length,outOfOrder:timestamps.some(function(value,index){return index>0&&value<timestamps[index-1]}),lastTimestamp:timestamps.length?timestamps[timestamps.length-1]:null}}
function formMetadataForQuality(){var f=$('#trackForm');var numberOrNull=function(name){var value=f.elements[name].value;return value===''?null:Number(value)};var duration=null;try{duration=parseDurationInput(f.elements.duration.value)}catch(e){}return {slug:f.elements.slug.value.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''),title:f.elements.title.value.trim(),status:f.elements.status.value,year:numberOrNull('year'),genres:split(f.elements.genres.value),moods:split(f.elements.moods.value),themes:split(f.elements.themes.value),energy:f.elements.energy.value.trim()||null,languages:split(f.elements.languages.value),key:f.elements.key.value.trim()||null,keyConfidence:numberOrNull('keyConfidence'),duration:duration}}
function addListQuality(items,value,label,required){if(!value.length)items.push(qualityItemClient(required?'warning':'info','client-'+label.toLowerCase()+'-missing',label,label+' non renseigné'+(required?'':' (facultatif)')+'.'));else if(value.some(function(item){return !item.trim()||item.length>80}))items.push(qualityItemClient('warning','client-'+label.toLowerCase()+'-format',label,label+' contient une valeur vide ou trop longue.'));else items.push(qualityItemClient('pass','client-'+label.toLowerCase()+'-ok',label,label+' correctement renseigné.'))}
function serverStructuralItems(){var report=state.currentTrackData&&state.currentTrackData.quality;if(!report)return [];return (report.items||[]).filter(function(item){return ['orphan-assets','duplicate-assets'].includes(item.code)||(item.code&&item.code.indexOf('r2-missing')>=0)}).map(function(item){return Object.assign({},item)})}
async function collectQualityEvidence(){var results=await Promise.all([inspectTimedMedia('audio'),inspectImageSource('cover'),inspectImageSource('thumbnail'),inspectTimedMedia('video'),inspectLyricsSource().catch(function(){return {readable:false}})]);var evidence={audio:results[0]||{},cover:results[1]||{},thumbnail:results[2]||{},video:results[3]||{},lyrics:results[4]||{}};if(selectedFile('cover'))evidence.thumbnail={readable:true,width:512,height:512,planned:true};return evidence}
function buildClientQuality(meta,evidence){var items=serverStructuralItems();var add=function(level,code,label,message,details){items.push(qualityItemClient(level,code,label,message,details))};if(/^[a-z0-9][a-z0-9-]{0,119}$/.test(meta.slug))add('pass','client-slug-valid','Slug','Slug valide.');else add('error','client-slug-invalid','Slug','Slug invalide.');if(meta.title)add('pass','client-title','Titre','Titre renseigné.');else add('error','client-title-missing','Titre','Titre obligatoire.');var audioExists=Boolean(selectedFile('audio')||currentAssetPresent('audio'));if(!audioExists)add('error','client-audio-missing','Audio','Aucun fichier audio.');else if(evidence.audio&&evidence.audio.readable===false)add('error','client-audio-unreadable','Audio','Le navigateur ne peut pas lire ce fichier audio.');else if(evidence.audio&&evidence.audio.readable)add('pass','client-audio-readable','Audio','Audio lisible.');else add('info','client-audio-pending','Audio','Audio présent, mesure non disponible.');var actualDuration=evidence.audio&&Number(evidence.audio.duration);if(meta.duration==null)add('warning','client-duration-missing','Durée','Durée non renseignée.');else if(Number.isFinite(actualDuration)){var tolerance=Math.max(3,actualDuration*.03);var difference=Math.abs(meta.duration-actualDuration);add(difference>tolerance?'error':'pass','client-duration-'+(difference>tolerance?'mismatch':'ok'),'Durée',difference>tolerance?'La durée saisie diffère de l’audio de '+difference.toFixed(1)+' s.':'Durée cohérente avec l’audio.')}var coverExists=Boolean(selectedFile('cover')||currentAssetPresent('cover'));if(!coverExists)add('error','client-cover-missing','Cover','Aucune pochette.');else if(evidence.cover&&evidence.cover.readable===false)add('error','client-cover-unreadable','Cover','Pochette illisible.');else if(evidence.cover&&evidence.cover.width){var minimum=Math.min(evidence.cover.width,evidence.cover.height);add(minimum<512?'error':minimum<1000?'warning':'pass','client-cover-size','Cover',minimum<512?'Pochette inférieure à 512 px.':minimum<1000?'Pochette valide mais inférieure à 1000 px.':'Dimensions de pochette suffisantes.',{width:evidence.cover.width,height:evidence.cover.height})}if(selectedFile('cover')||currentAssetPresent('thumbnail'))add('pass','client-thumbnail','Thumbnail',selectedFile('cover')?'Miniature 512 px générée à l’enregistrement.':'Miniature optimisée présente.');else add('warning','client-thumbnail-missing','Thumbnail','Miniature optimisée absente.');if(evidence.lyrics&&evidence.lyrics.readable===false)add('error','client-lyrics-unreadable','Lyrics','Fichier de paroles illisible.');else if(evidence.lyrics&&evidence.lyrics.readable){add('pass','client-lyrics-readable','Lyrics','Paroles présentes et lisibles.');if(!evidence.lyrics.timestampCount)add('info','client-lyrics-unsynced','Synchronisation','Paroles non timestampées : le lecteur affichera clairement ce statut.');else{add(evidence.lyrics.outOfOrder?'error':'pass','client-timestamp-order','Synchronisation',evidence.lyrics.outOfOrder?'Timestamps non triés.':evidence.lyrics.timestampCount+' timestamp(s) trié(s).');var reference=Number.isFinite(actualDuration)?actualDuration:meta.duration;if(reference!=null&&evidence.lyrics.lastTimestamp>reference+2)add('error','client-timestamp-after','Synchronisation','Le dernier timestamp dépasse la fin du morceau.')}}else add('info','client-lyrics-absent','Lyrics','Aucune lyrics, fichier facultatif.');if(meta.year==null)add('warning','client-year-missing','Année','Année non renseignée.');else if(meta.year<1900||meta.year>2200)add('error','client-year-invalid','Année','Année invalide.');else add('pass','client-year-valid','Année','Année valide.');if(meta.energy)add('pass','client-energy','Énergie','Énergie renseignée.');else add('warning','client-energy-missing','Énergie','Énergie non renseignée.');addListQuality(items,meta.genres,'Genres',true);addListQuality(items,meta.moods,'Moods',false);addListQuality(items,meta.themes,'Thèmes',false);addListQuality(items,meta.languages,'Langues',true);if(meta.keyConfidence!=null&&meta.keyConfidence<.5)add('warning','client-key-confidence','Tonalité','Tonalité à faible confiance.');else if(meta.key&&meta.keyConfidence!=null)add('pass','client-key-ok','Tonalité','Confiance de tonalité acceptable.');else add('info','client-key-unreviewed','Tonalité','Tonalité ou confiance non renseignée.');var videoExists=Boolean(selectedFile('video')||currentAssetPresent('video'));if(!videoExists)add('info','client-canvas-absent','Canvas','Aucun Canvas, média facultatif.');else if(evidence.video&&evidence.video.readable===false)add('error','client-canvas-unreadable','Canvas','Canvas illisible.');else if(evidence.video&&evidence.video.width){var ratio=evidence.video.width/evidence.video.height;var differenceRatio=Math.abs(ratio-9/16);add(evidence.video.height<=evidence.video.width||differenceRatio>.09?'error':differenceRatio>.035?'warning':'pass','client-canvas-ratio','Canvas',evidence.video.height<=evidence.video.width||differenceRatio>.09?'Le Canvas doit être vertical et proche de 9:16.':differenceRatio>.035?'Canvas vertical mais ratio légèrement éloigné de 9:16.':'Canvas vertical proche de 9:16.',{width:evidence.video.width,height:evidence.video.height});var size=selectedFile('video')&&selectedFile('video').size||evidence.video.size;if(size>50*1024*1024)add('error','client-canvas-size','Canvas','Canvas supérieur à 50 Mo.');else if(size>25*1024*1024)add('warning','client-canvas-heavy','Canvas','Canvas supérieur à 25 Mo.');else add('pass','client-canvas-size','Canvas','Taille du Canvas acceptable.')}return reportFromItems(items,'browser')}
async function runQualityCheck(options){options=options||{};if(state.qualityChecking)return state.qualityReport;state.qualityChecking=true;$('#qualityState').className='quality-state review';$('#qualityState').textContent='Analyse…';$('#qualitySubtitle').textContent='Lecture des médias et vérification du formulaire.';try{var evidence=options.light?{}:await collectQualityEvidence();var report=buildClientQuality(formMetadataForQuality(),evidence);report.evidence=evidence;renderQuality(report);return report}finally{state.qualityChecking=false}}
function scheduleQualityCheck(){clearTimeout(qualityTimer);qualityTimer=setTimeout(function(){runQualityCheck({light:true})},450)}
function updateSaveButtonLabel(){var status=$('#trackForm').elements.status.value;$('#saveTrack').textContent=status==='published'?'Publier':status==='draft'?'Enregistrer le brouillon':'Enregistrer'}

var originalOpenNew=openNew;openNew=function(){state.currentTrackData=null;state.qualityReport=null;originalOpenNew();renderQuality(null);updateSaveButtonLabel();scheduleQualityCheck()};
edit=function(slug){api('/api/tracks/'+encodeURIComponent(slug)).then(function(data){state.editing=slug;state.currentTrackData=data.track;emptyForm();setForm(data.track.manifest);$('#editorTitle').textContent='Modifier '+data.track.manifest.title;renderQuality(Object.assign({source:'r2'},data.track.quality||{}));updateSaveButtonLabel();openModal('editorModal')}).catch(function(e){showNotice(e.message,true)})};
renderTracks=function(){var q=$('#search').value.trim().toLowerCase();var tracks=state.tracks.filter(function(t){return !q||[t.title,t.slug,t.album&&t.album.title,(t.genres||[]).join(' '),(t.moods||[]).join(' ')].join(' ').toLowerCase().includes(q)});$('#countLabel').textContent=tracks.length+(tracks.length>1?' morceaux':' morceau');var grid=$('#trackGrid');if(!tracks.length){grid.innerHTML='<div class="empty"><strong>Aucun titre trouvé</strong><span class="sub">Essaie une autre recherche dans le catalogue.</span></div>';return}grid.innerHTML=tracks.map(function(t){var cover=t.assets.cover&&t.assets.cover.present?'/api/media/'+encodeURIComponent(t.slug)+'/cover':'';var quality=t.quality||{state:t.complete?'ready':'blocked',counts:{error:t.complete?0:1,warning:0}};var qualityChips='<span class="chip '+(quality.state==='ready'?'ok':quality.state==='blocked'?'error':'warn')+'">'+(quality.state==='ready'?'qualité OK':quality.state==='blocked'?'publication bloquée':'à vérifier')+'</span>'+(quality.counts&&quality.counts.warning?'<span class="chip warn">⚠ '+quality.counts.warning+'</span>':'')+(quality.counts&&quality.counts.error?'<span class="chip error">✕ '+quality.counts.error+'</span>':'');var chips=['<span class="chip '+(t.status==='published'?'ok':'warn')+'">'+esc(t.status)+'</span>',qualityChips,'<span class="chip '+(t.assets.thumbnail&&t.assets.thumbnail.present?'ok':'warn')+'">'+(t.assets.thumbnail&&t.assets.thumbnail.present?'thumbnail optimisée':'thumbnail absente')+'</span>'].concat((t.genres||[]).slice(0,3).map(function(x){return '<span class="chip">'+esc(x)+'</span>'})).join('');return '<article class="track">'+(cover?'<img class="cover" loading="lazy" src="'+cover+'" alt="">':'<div class="cover placeholder">NO COVER</div>')+'<div><h3>'+esc(t.title)+'</h3><div class="sub">'+esc((t.album&&t.album.title)||'Singles')+' · '+esc(t.year||'—')+'</div><div class="chips">'+chips+'</div><div class="sub">'+formatBytes(t.totalBytes)+'</div><div class="trackactions"><button class="btn small" data-edit="'+esc(t.slug)+'">Modifier</button><button class="btn small danger" data-delete="'+esc(t.slug)+'">Supprimer</button></div></div></article>'}).join('')};

save=async function(ev){ev.preventDefault();var f=$('#trackForm');var slug=f.elements.slug.value.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');if(!slug){showNotice('Slug invalide.',true);return}var n=function(name){var v=f.elements[name].value;return v===''?null:Number(v)};var duration;try{duration=parseDurationInput(f.elements.duration.value)}catch(e){showNotice(e.message,true);return}var explicit=f.elements.explicit.value==='null'?null:f.elements.explicit.value==='true';var meta={slug:slug,title:f.elements.title.value.trim(),status:f.elements.status.value,type:f.elements.type.value,year:n('year'),releaseDate:f.elements.releaseDate.value||null,album:{id:f.elements.albumId.value.trim()||'singles',title:f.elements.albumTitle.value.trim()||'Singles'},genres:split(f.elements.genres.value),tags:split(f.elements.genres.value),moods:split(f.elements.moods.value),themes:split(f.elements.themes.value),era:f.elements.era.value.trim()||null,energy:f.elements.energy.value.trim()||null,languages:split(f.elements.languages.value),bpm:n('bpm'),key:f.elements.key.value.trim()||null,keyConfidence:n('keyConfidence'),duration:duration,explicit:explicit,accent:f.elements.accent.value,accent2:f.elements.accent2.value};var report=await runQualityCheck();if(meta.status==='published'&&!report.publishable){showNotice('Publication bloquée : corrige les erreurs en rouge ou enregistre comme brouillon.',true);return}var fd=new FormData();fd.append('metadata',JSON.stringify(meta));fd.append('qualityEvidence',JSON.stringify(report.evidence||{}));fd.append('create_only',state.editing?'false':'true');['audio','cover','lyrics','video'].forEach(function(k){var file=f.elements[k].files[0];if(file)fd.append(k,file)});var coverFile=f.elements.cover.files[0];if(coverFile){try{var thumbnailResult=await createThumbnailResult(coverFile);fd.append('thumbnail',new File([thumbnailResult.blob],'thumbnail.webp',{type:'image/webp'}));if(!report.evidence)report.evidence={};report.evidence.thumbnail={readable:true,width:512,height:512,size:thumbnailResult.blob.size};fd.set('qualityEvidence',JSON.stringify(report.evidence))}catch(e){showNotice('Miniature non générée : '+e.message,true);if(meta.status==='published')return}}$('#saveTrack').disabled=true;$('#qualityCheck').disabled=true;try{var response=await fetch('/api/tracks/'+encodeURIComponent(slug),{method:'PUT',body:fd});var data=await response.json().catch(function(){return {ok:false,error:'Réponse invalide'}});if(data.quality)renderQuality(Object.assign({source:'r2'},data.quality));if(!response.ok||!data.ok){if(response.status===409)showNotice(data.details||'Publication bloquée par le contrôle qualité.',true);else showNotice(data.details||data.error||('HTTP '+response.status),true);return}closeModal('editorModal');showNotice(meta.status==='published'?'Titre publié.':'Brouillon enregistré.');await load()}catch(error){showNotice(error.message,true)}finally{$('#saveTrack').disabled=false;$('#qualityCheck').disabled=false}};

installQualityWorkspace();
$('#qualityCheck').addEventListener('click',function(){runQualityCheck()});
$('#trackForm').elements.status.addEventListener('change',function(){updateSaveButtonLabel();scheduleQualityCheck()});
$('#trackForm').addEventListener('input',function(event){if(event.target.type!=='file')scheduleQualityCheck()});
['audio','cover','lyrics','video'].forEach(function(kind){$('#trackForm').elements[kind].addEventListener('change',scheduleQualityCheck)});
$('#newTrack').addEventListener('click',openNew);$('#refresh').addEventListener('click',load);$('#search').addEventListener('input',renderTracks);$('#trackForm').addEventListener('submit',save);$('#trackForm').elements.lyrics.addEventListener('change',importLyricsTxtFile);$('#optimizeCovers').addEventListener('click',optimizeAllCovers);load();
})();
</script>
</body>
</html>`;