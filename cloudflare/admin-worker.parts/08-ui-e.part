eg.dataset.legacy)});$('#newTrack').addEventListener('click',openNew);$('#refresh').addEventListener('click',load);$('#search').addEventListener('input',renderTracks);$('#trackForm').addEventListener('submit',save);$('#importGithub').addEventListener('click',prepareMigration);$('#migrateLegacy').addEventListener('click',function(){migrateLegacy(null)});$('#optimizeCovers').addEventListener('click',optimizeAllCovers);$('#startMigration').addEventListener('click',startMigration);load();
