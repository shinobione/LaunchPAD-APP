en;gap:12px;padding:10px;border:1px solid var(--line);border-radius:10px}.migrationrow .state{color:var(--muted);font-size:.78rem}@media(max-width:1050px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.app{width:min(100% - 18px,1440px)}.top{align-items:flex-start}.user{display:none}.toolbar{align-items:stretch}.search{margin-left:0;order:3;width:100%}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:1fr;padding:9px}.track{grid-template-columns:72px minmax(0,1fr)}.cover{width:72px}.form{grid-template-columns:1fr}.field.full,.files{grid-column:auto}.files{grid-template-columns:1fr}.legacyrow{align-items:flex-start;flex-direction:column}}
.toolbar{position:sticky;top:0;z-index:10;padding:10px;border:1px solid var(--line);border-radius:14px;background:rgba(9,11,12,.9);backdrop-filter:blur(18px)}.toolbar-group{display:flex;flex-wrap:wrap;gap:8px}.toolbar-group.maintenance{padding-left:9px;border-left:1px solid var(--line)}.form-section{grid-column:1/-1;margin:7px 0 -2px;padding-top:13px;border-top:1px solid var(--line);color:#7de7a3;font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.form-section:first-child{margin-top:0;padding-top:0;border-top:0}.field input:focus,.field select:focus,.field textarea:focus,.search:focus,.btn:focus-visible{outline:2px solid rgba(125,231,163,.9);outline-offset:2px;border-color:transparent}.field input:invalid:not(:placeholder-shown){border-color:rgba(255,112,126,.72)}.color-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}.color-pair input{min-height:42px;padding:4px}.track{transition:transform .16s,border-color .16s,background .16s}.track:hover{transform:translateY(-2px);border-color:rgba(125,231,163,.25);background:rgba(255,255,255,.035)}@media(max-width:700px){.toolbar{position:static}.toolbar-group,.toolbar-group.maintenance{width:100%;padding:0;border:0}.toolbar-group .btn{flex:1}.form-section{grid-column:auto}}
</style>
</head>
<body>
<div class="app">
  <header class="top"><div class="brand"><div class="logo" aria-hidden="true">LP</div><div><h1>LaunchPAD Track Manager</h1><div class="sub">Catalogue, miniatures et publication Cloudflare R2</div></div></div><div class="user"><div class="sub">Connecté avec</div><strong>__USER_EMAIL__</strong></div></header>
  <div class="toolbar" aria-label="Actions du catalogue"><div class="toolbar-group"><button class="btn primary" id="newTrack">＋ Ajouter un titre</button><button class="btn" id="refresh">Actualiser</button></div><div class="toolbar-group maintenance"><button class="btn" id="importGithub">Importer l’ancien catalogue</button><button class="btn" id="migrateLegacy">Ranger les fichiers de test</button><button class="btn" id="optimizeCovers">Optimiser les covers</button></div><input class="search" id="search" type="search" aria-label="Rechercher dans le catalogue" placeholder="Rechercher un titre, album, genre…"></div>
  <section class="stats"><div class="stat"><b id="sTotal">—</b><span>Titres</span></div><div class="stat"><b id="sPublished">—</b><span>Publiés</span></div><div class="stat"><b id="sDraft">—</b><span>Brouillons</span></div><div class="stat"><b id="sIncomplete">—</b><span>Incomplets</span></div><div class="stat"><b id="sStorage">—</b><span>Stockage catalogue</span></div></section>
  <section class="panel"><div class="panelhead"><h2>Bibliothèque R2</h2><span class="sub" id="countLabel"></span></div><div class="grid" id="trackGrid"><div class="empty">Chargement…</div></div></section>
  <section class="panel legacy" id="legacyPanel" hidden><div class="panelhead"><h2>Fichiers hérités à ranger</h2><span class="sub">Ancienne structure <code>media/</code></span></div><div class="legacylist" id="legacyList"></div></section>
</div>
<div class="notice" id="notice"></div>
<div class="modal" id="editorModal"><div class="dialog"><div class="dialoghead"><h2 id="editorTitle">Ajouter un titre</h2><button class="btn small" data-close="editorModal">Fermer</button></div><form id="trackForm"><div class="form">
<div class="form-section">Identité et publication</div>
<div class="field"><label>Titre *</label><input name="title" required></div><div class="field"><label>Slug *</label><input name="slug" pattern="[a-z0-9-]+" required></div>
<div class="field"><label>Statut</label><select name="status"><option value="draft">Brouillon</option><option value="published">Publié</option><option value="archived">Archivé</option></select></div><div class="field"><label>Type</label><select name="type"><option value="single">Single</option><option value="album-track">Titre d’album</option><option value="demo">Démo</option></select></div>
<div class="field"><label>Année</label><input name="year" type="number" min="1900" max="2200"></div><div class="field"><label>Date de sortie</label><input name="releaseDate" type="date"></div>
<div class="field"><label>ID album</label><input name="albumId" value="singles"></div><div class="field"><label>Nom album</label><input name="albumTitle" value="Singles"></div>
<div class="form-section">Découverte et signal musical</div>
<div class="field full"><label>Genres / tags (séparés par des virgules)</label><input name="genres"></div><div class="field full"><label>Moods</label><input name="moods"></div><div class="field full"><label>Thèmes</label><input name="themes"></div>
<div class="field"><label>Ère</label><input name="era"></div><div class="field"><label>Énergie</label><input name="energy"></div><div class="field full"><label>Langues</label><input name="languages" placeholder="English, French, Vietnamese"></div>
<div class="field"><label>BPM</label><input name="bpm" type="number" step="1"></div><div class="field"><label>Tonalité</label><input name="key" placeholder="F# minor"></div><div class="field"><label>Confiance tonalité</label><input name="keyConfidence" type="number" step="0.001" min="0" max="1"></div><div class="field"><label>Durée (mm:ss)</label><input name="duration" type="text" inputmode="numeric" placeholder="03:57" pattern="(?:[0-9]+:)?[0-5][0-9](?:\\.[0-9]{1,3})?"></div>
<div class="field"><label>Contenu</label><select name="explicit"><option value="null">Non vérifié</option><option value="false">Clean</option><option value="true">Explicit</option></select></div><div class="field"><label>Couleurs du thème</label><div class="color-pair"><input name="accent" type="color" value="#1db954" aria-label="Couleur principale"><input name="accent2" type="color" value="#556bff" aria-label="Couleur secondaire"></div></div>
<div class="form-section">Fichiers médias</div>
<div class="files"><div class="filebox"><label>Audio *</label><input name="audio" type="file" accept="audio/*,.mp3,.wav,.flac,.m4a,.aac,.ogg"><small id="currentAudio"></small></div><div class="filebox"><label>Pochette *</label><input name="cover" type="file" accept="image/*,.jpg,.jpeg,.png,.webp,.gif"><small id="currentCover"></small></div><div class="filebox"><label>Lyrics</label><input name="lyrics" type="file" accept="text/plain,.txt"><small id="currentLyrics"></small></div><div class="filebox"><label>Vidéo</label><input name="video" type="file" accept="video/mp4,video/webm,.mp4,.webm"><small id="currentVideo"></small></div></div>
</div><div class="dialogfoot"><button type="button" class="btn" data-close="editorModal">Annuler</button><button class="btn primary" id="saveTrack">Enregistrer</button></div></form></div></div>
<div class="modal" id="migrationModal"><div class="dialog" style="width:min(760px,100%)"><div class="dialoghead"><h2>Migration GitHub → Cloudflare R2</h2><button class="btn small" data-close="migrationModal">Fermer</button></div><div class="migration"><div class="sub">Les fichiers sont importés directement depuis le dépôt public, un titre après l’autre. Aucun TXT manuel à créer.</div><div class="progress"><div id="migrationBar"></div></div><div class="migrationlist" id="migrationList"></div><div class="dialogfoot" style="padding:16px 0 0"><button class="btn primary" id="startMigration">Démarrer l’import</button></div></div></div></div>
<script>
(function(){
'use strict';
var state={tracks:[],legacyTracks:[],plan:null,editing:null,running:false};
var $=function(s){return docume

