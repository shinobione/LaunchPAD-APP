en;gap:12px;padding:10px;border:1px solid var(--line);border-radius:10px}.migrationrow .state{color:var(--muted);font-size:.78rem}@media(max-width:1050px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.app{width:min(100% - 18px,1440px)}.top{align-items:flex-start}.user{display:none}.toolbar{align-items:stretch}.search{margin-left:0;order:3;width:100%}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:1fr;padding:9px}.track{grid-template-columns:72px minmax(0,1fr)}.cover{width:72px}.form{grid-template-columns:1fr}.field.full,.files{grid-column:auto}.files{grid-template-columns:1fr}.legacyrow{align-items:flex-start;flex-direction:column}}
.toolbar{position:sticky;top:0;z-index:10;padding:10px;border:1px solid var(--line);border-radius:14px;background:rgba(9,11,12,.9);backdrop-filter:blur(18px)}.toolbar-group{display:flex;flex-wrap:wrap;gap:8px}.toolbar-group.maintenance{padding-left:9px;border-left:1px solid var(--line)}.form-section{grid-column:1/-1;margin:7px 0 -2px;padding-top:13px;border-top:1px solid var(--line);color:#7de7a3;font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.form-section:first-child{margin-top:0;padding-top:0;border-top:0}.field input:focus,.field select:focus,.field textarea:focus,.search:focus,.btn:focus-visible{outline:2px solid rgba(125,231,163,.9);outline-offset:2px;border-color:transparent}.field input:invalid:not(:placeholder-shown){border-color:rgba(255,112,126,.72)}.color-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}.color-pair input{min-height:42px;padding:4px}.track{transition:transform .16s,border-color .16s,background .16s}.track:hover{transform:translateY(-2px);border-color:rgba(125,231,163,.25);background:rgba(255,255,255,.035)}@media(max-width:700px){.toolbar{position:static}.toolbar-group,.toolbar-group.maintenance{width:100%;padding:0;border:0}.toolbar-group .btn{flex:1}.form-section{grid-column:auto}}
/* Daily Track Manager workspace */
:root{--green-soft:#78edaa;--violet:#7d82ff;--panel-raised:#151a18}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(115deg,rgba(29,185,84,.035),transparent 35%,rgba(125,130,255,.025));z-index:-1}
.top{padding:8px 4px 4px}.brand-copy{display:grid;gap:3px}.eyebrow{display:flex;align-items:center;gap:8px;color:var(--green-soft);font-size:.67rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.version-pill,.count-pill{display:inline-flex;align-items:center;border:1px solid rgba(125,231,163,.18);border-radius:999px;background:rgba(125,231,163,.07);color:#9ff3bf;padding:4px 8px;font-size:.66rem;font-weight:800;letter-spacing:.04em}.user-card{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--line);border-radius:14px;background:rgba(17,21,20,.72)}.user-card strong{display:block;max-width:260px;overflow:hidden;text-overflow:ellipsis;font-size:.78rem}.status-dot{width:9px;height:9px;border-radius:50%;background:var(--green-soft);box-shadow:0 0 0 5px rgba(125,231,163,.08),0 0 18px rgba(125,231,163,.45)}
.toolbar{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:17px;box-shadow:0 16px 45px rgba(0,0,0,.2)}.toolbar-main{display:flex;align-items:center;gap:8px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px}.btn.primary{box-shadow:0 9px 24px rgba(29,185,84,.16)}.btn-icon{font-size:1rem;line-height:1}.icon-only{width:40px;padding:0;font-size:1.1rem}.searchbox{display:flex;align-items:center;gap:9px;margin-left:auto;min-width:min(360px,100%);padding:0 12px;border:1px solid var(--line);border-radius:12px;background:#111514;color:#718078;transition:border-color .16s,background .16s}.searchbox:focus-within{border-color:rgba(125,231,163,.42);background:#141a17}.searchbox .search{width:100%;min-width:0;margin:0;padding:11px 0;border:0;background:transparent;outline:0}
.stats{gap:12px}.stat{position:relative;isolation:isolate;min-height:104px;padding:18px;overflow:hidden;background:linear-gradient(145deg,rgba(21,26,24,.96),rgba(13,17,15,.9))}.stat:after{content:attr(data-icon);position:absolute;right:13px;bottom:3px;z-index:-1;color:rgba(255,255,255,.045);font-size:3.1rem;font-weight:900}.stat b{margin-top:8px;font-size:1.65rem;letter-spacing:-.04em}.stat span{font-weight:720}.stat[data-tone="published"]{border-color:rgba(125,231,163,.17)}.stat[data-tone="draft"]{border-color:rgba(255,208,138,.13)}.stat[data-tone="alert"]{border-color:rgba(255,112,126,.13)}.stat[data-tone="storage"]{border-color:rgba(125,130,255,.17)}
.panel{overflow:hidden;background:linear-gradient(155deg,rgba(17,21,20,.94),rgba(12,15,14,.92))}.panelhead{padding:18px 20px}.panel-title{display:grid;gap:4px}.panelhead h2{font-size:1.08rem}.grid{gap:14px;padding:16px}.track{position:relative;padding:14px;border-radius:17px;background:linear-gradient(145deg,rgba(255,255,255,.028),rgba(255,255,255,.012))}.track:after{content:"";position:absolute;inset:auto 12px 0;height:1px;background:linear-gradient(90deg,transparent,rgba(125,231,163,.18),transparent);opacity:0;transition:opacity .16s}.track:hover:after{opacity:1}.cover{box-shadow:0 10px 28px rgba(0,0,0,.28)}.trackactions .btn:not(.danger){border-color:rgba(125,231,163,.16);color:#a5f3c2}.empty{min-height:210px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}.empty strong{color:#dce5e0}.empty span{max-width:330px}.loader{width:26px;height:26px;border:2px solid rgba(125,231,163,.14);border-top-color:var(--green-soft);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:700px){.top{gap:10px}.user-card{display:none}.toolbar{align-items:stretch}.toolbar-main{width:100%;display:grid;grid-template-columns:1fr 40px 1fr}.toolbar-main .btn{min-width:0}.searchbox{width:100%;margin:0}.stat{min-height:94px}}

</style>
</head>
<body>
<div class="app">
  <header class="top"><div class="brand"><div class="logo" aria-hidden="true">LP</div><div class="brand-copy"><div class="eyebrow">Cloudflare R2 <span class="version-pill">v4.5</span></div><h1>LaunchPAD Track Manager</h1><div class="sub">Pilote le catalogue, les médias et la publication</div></div></div><div class="user-card"><span class="status-dot" aria-hidden="true"></span><div><div class="sub">Session protégée</div><strong>__USER_EMAIL__</strong></div></div></header>
  <div class="toolbar" aria-label="Actions du catalogue"><div class="toolbar-main"><button class="btn primary" id="newTrack"><span class="btn-icon" aria-hidden="true">＋</span>Ajouter un titre</button><button class="btn icon-only" id="refresh" type="button" aria-label="Actualiser le catalogue" title="Actualiser"><span aria-hidden="true">↻</span></button><button class="btn" id="optimizeCovers" type="button"><span class="btn-icon" aria-hidden="true">◇</span>Optimiser les covers</button></div><label class="searchbox"><span aria-hidden="true">⌕</span><input class="search" id="search" type="search" aria-label="Rechercher dans le catalogue" placeholder="Titre, album, genre…"></label></div>
  <section class="stats" aria-label="État du catalogue"><div class="stat" data-icon="♪"><span>Titres</span><b id="sTotal">—</b></div><div class="stat" data-tone="published" data-icon="✓"><span>Publiés</span><b id="sPublished">—</b></div><div class="stat" data-tone="draft" data-icon="◌"><span>Brouillons</span><b id="sDraft">—</b></div><div class="stat" data-tone="alert" data-icon="!"><span>Incomplets</span><b id="sIncomplete">—</b></div><div class="stat" data-tone="storage" data-icon="◇"><span>Stockage catalogue</span><b id="sStorage">—</b></div></section>
  <section class="panel"><div class="panelhead"><div class="panel-title"><div class="eyebrow">Catalogue canonique</div><h2>Bibliothèque R2</h2></div><span class="count-pill" id="countLabel">Synchronisation…</span></div><div class="grid" id="trackGrid"><div class="empty"><span class="loader" aria-hidden="true"></span><strong>Chargement du catalogue</strong><span class="sub">Lecture des morceaux et des médias R2…</span></div></div></section>
</div>
<div class="notice" id="notice"></div>
<div class="modal" id="editorModal"><div class="dialog"><div class="dialoghead"><h2 id="editorTitle">Ajouter un titre</h2><button class="btn small" data-close="editorModal">Fermer</button></div><form id="trackForm"><div class="form">
<div class="form-section">Identité et publication</div>
<div class="field"><label>Titre *</label><input name="title" required></div><div class="field"><label>Slug *</label><input name="slug" pattern="[a-z0-9-]+" required></div>
<div class="field"><label>Statut</label><select name="status"><option value="draft">Brouillon</option><option value="published">Publié</option><option value="archived">Archivé</option></select></div><div class="field"><label>Type</label><select name="type"><option value="single">Single</option><option value="album-track">Titre d’album</option><option value="demo">Démo</option></select></div>
<div class="field"><label>Année</label><input name="year" type="number" min="1900" max="2200"></div><div class="field"><label>Date de sortie</label><input name="releaseDate" type="date"></div>
<div class="field"><label>ID album</label><input name="albumId" value="singles"></div><div class="field"><label>Nom album</label><input name="albumTitle" value="Singles"></div>
<div class="form-section">Découverte et signal musical</div>
<div class="field full"><label>Genres / tags (séparés par des virgules)</label><input name="genres"></div><div class="field full"><label>Moods</label><input name="moods"></div><div class="field full"><label>Thèmes</label><input name="themes"></div>
<div class="field"><label>Ère</label><input name="era"></div><div class="field"><label>Énergie</label><input name="energy"></div><div class="field full"><label>Langues</label><input name="languages" placeholder="English, French, Vietnamese"></div>
<div class="field"><label>BPM</label><input name="bpm" type="number" step="1"></div><div class="field"><label>Tonalité</label><input name="key" placeholder="F# minor"></div><div class="field"><label>Confiance tonalité</label><input name="keyConfidence" type="number" step="0.001" min="0" max="1"></div><div class="field"><label>Durée (mm:ss)</label><input name="duration" type="text" inputmode="numeric" placeholder="03:57" pattern="(?:[0-9]+:)?[0-5][0-9](?:\\.[0-9]{1,3})?"></div>
<div class="field"><label>Contenu</label><select name="explicit"><option value="null">Non vérifié</option><option value="false">Clean</option><option value="true">Explicit</option></select></div><div class="field"><label>Couleurs du thème</label><div class="color-pair"><input name="accent" type="color" value="#1db954" aria-label="Couleur principale"><input name="accent2" type="color" value="#556bff" aria-label="Couleur secondaire"></div></div>
<div class="form-section">Fichiers médias</div>
<div class="files"><div class="filebox"><label>Audio *</label><input name="audio" type="file" accept="audio/*,.mp3,.wav,.flac,.m4a,.aac,.ogg"><small id="currentAudio"></small></div><div class="filebox"><label>Pochette *</label><input name="cover" type="file" accept="image/*,.jpg,.jpeg,.png,.webp,.gif"><small id="currentCover"></small></div><div class="filebox"><label>Lyrics</label><input name="lyrics" type="file" accept="text/plain,.txt"><small id="currentLyrics"></small></div><div class="filebox"><label>Vidéo</label><input name="video" type="file" accept="video/mp4,video/webm,.mp4,.webm"><small id="currentVideo"></small></div></div>
</div><div class="dialogfoot"><button type="button" class="btn" data-close="editorModal">Annuler</button><button class="btn primary" id="saveTrack">Enregistrer</button></div></form></div></div>
<script>
(function(){
'use strict';
var state={tracks:[],legacyTracks:[],plan:null,editing:null,running:false};
var $=function(s){return docume

