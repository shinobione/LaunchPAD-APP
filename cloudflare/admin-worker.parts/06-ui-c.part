nt.querySelector(s)};
var noticeTimer;
function showNotice(message,error){var el=$('#notice');el.textContent=message;el.className='notice show'+(error?' error':'');clearTimeout(noticeTimer);noticeTimer=setTimeout(function(){el.className='notice'},5000)}
function api(path,options){options=options||{};options.headers=Object.assign({'Accept':'application/json'},options.headers||{});return fetch(path,options).then(async function(r){var data=await r.json().catch(function(){return {ok:false,error:'Réponse invalide'}});if(!r.ok||!data.ok)throw new Error(data.details||data.error||('HTTP '+r.status));return data})}
function formatBytes(bytes){var n=Number(bytes||0);if(n<1024)return n+' o';if(n<1048576)return (n/1024).toFixed(1)+' Ko';if(n<1073741824)return (n/1048576).toFixed(1)+' Mo';return (n/1073741824).toFixed(2)+' Go'}
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]})}
function openModal(id){$('#'+id).classList.add('open')}
function closeModal(id){$('#'+id).classList.remove('open')}
function split(v){return String(v||'').split(',').map(function(x){return x.trim()}).filter(Boolean)}
function formatDurationInput(value){var seconds=Number(value);if(!Number.isFinite(seconds)||seconds<0)return '';var minutes=Math.floor(seconds/60);var remainder=Math.round((seconds-minutes*60)*1000)/1000;var whole=Math.floor(remainder);var fraction=remainder-whole;return String(minutes).padStart(2,'0')+':'+String(whole).padStart(2,'0')+(fraction?fraction.toFixed(3).slice(1).replace(/0+$/,''):'')}
function parseDurationInput(value){var clean=String(value||'').trim();if(!clean)return null;var match=clean.match(/^(\d+):([0-5]\d)(?:\.(\d{1,3}))?$/);if(!match)throw new Error('La durée doit utiliser le format mm:ss (ex. 03:57).');return Number(match[1])*60+Number(match[2])+Number('0.'+(match[3]||'0'))}
function load(){return api('/api/tracks').then(function(data){state.tracks=data.tracks;state.legacyTracks=data.legacyTracks;render(data.totals)}) .catch(function(e){showNotice(e.message,true)})}
function render(totals){$('#sTotal').textContent=totals.total;$('#sPublished').textContent=totals.published||0;$('#sDraft').textContent=totals.draft||0;$('#sIncomplete').textContent=totals.incomplete||0;$('#sStorage').textContent=formatBytes(totals.bytes);renderTracks()}
function renderTracks(){var q=$('#search').value.trim().toLowerCase();var tracks=state.tracks.filter(function(t){return !q||[t.title,t.slug,t.album&&t.album.title,(t.genres||[]).join(' '),(t.moods||[]).join(' ')].join(' ').toLowerCase().includes(q)});$('#countLabel').textContent=tracks.length+(tracks.length>1?' morceaux':' morceau');var grid=$('#trackGrid');if(!tracks.length){grid.innerHTML='<div class="empty"><strong>Aucun titre trouvé</strong><span class="sub">Essaie une autre recherche dans le catalogue.</span></div>';return}grid.innerHTML=tracks.map(function(t){var cover=t.assets.cover&&t.assets.cover.present?'/api/media/'+encodeURIComponent(t.slug)+'/cover':'';var chips=['<span class="chip '+(t.status==='published'?'ok':'warn')+'">'+esc(t.status)+'</span>','<span class="chip">'+(t.complete?'fichiers complets':'incomplet')+'</span>','<span class="chip '+(t.assets.thumbnail&&t.assets.thumbnail.present?'ok':'warn')+'">'+(t.assets.thumbnail&&t.assets.thumbnail.present?'cover optimisée':'cover lourde')+'</span>'].concat((t.genres||[]).slice(0,3).map(function(x){return '<span class="chip">'+esc(x)+'</span>'})).join('');return '<article class="track">'+(cover?'<img class="cover" loading="lazy" src="'+cover+'" alt="">':'<div class="cover placeholder">NO COVER</div>')+'<div><h3>'+esc(t.title)+'</h3><div class="sub">'+esc((t.album&&t.album.title)||'Singles')+' · '+esc(t.year||'—')+'</div><div class="chips">'+chips+'</div><div class="sub">'+formatBytes(t.totalBytes)+'</div><div class="trackactions"><button class="btn small" data-edit="'+esc(t.slug)+'">Modifier</button><button class="btn small danger" data-delete="'+esc(t.slug)+'">Supprimer</button></div></div></article>'}).join('')}
function renderLegacy(){var panel=$('#legacyPanel');panel.hidden=!state.legacyTracks.length;if(!state.legacyTracks.length)return;$('#legacyList').innerHTML=state.legacyTracks.map(function(t){return '<div class="legacyrow"><div><strong>'+esc(t.title)+'</strong><div class="sub">'+esc(t.slug)+' · '+formatBytes(t.totalBytes)+'</div></div><button class="btn small" data-legacy="'+esc(t.slug)+'">Ranger dans le catalogue</button></div>'}).join('')}
function emptyForm(){var f=$('#trackForm');f.reset();f.elements.status.value='draft';f.elements.type.value='single';f.elements.albumId.value='singles';f.elements.albumTitle.value='Singles';f.elements.explicit.value='null';f.elements.accent.value='#1db954';f.elements.accent2.value='#556bff';['Audio','Cover','Lyrics','Video'].forEach(function(x){$('#current'+x).textContent=''})}
function setForm(m){var f=$('#trackForm');f.elements.title.value=m.title||'';f.elements.slug.value=m.slug||'';f.elements.slug.readOnly=true;f.elements.status.value=m.status||'draft';f.elements.type.value=m.type||'single';f.elements.year.value=m.year||'';f.elements.releaseDate.value=m.releaseDate||'';f.elements.albumId.value=m.album&&m.album.id||'singles';f.elements.albumTitle.value=m.album&&m.album.title||'Singles';f.elements.genres.value=(m.genres||[]).join(', ');f.elements.moods.value=(m.moods||[]).join(', ');f.elements.themes.value=(m.themes||[]).join(', ');f.elements.era.value=m.era||'';f.elements.energy.value=m.energy||'';f.elements.languages.value=(m.languages||[]).join(', ');f.elements.bpm.value=m.bpm==null?'':m.bpm;f.elements.key.value=m.key||'';f.elements.keyConfidence.value=m.keyConfidence==null?'':m.keyConfidence;f.elements.duration.value=formatDurationInput(m.duration);f.elements.explicit.value=m.explicit==null?'null':String(m.explicit);f.elements.accent.value=m.accent||'#1db954';f.elements.accent2.value=m.accent2||'#556bff';['audio','cover','lyrics','video'].forEach(function(k){$('#current'+k.charAt(0).toUpperCase()+k.slice(1)).textContent=m.assets&&m.assets[k]?('Actuel : '+m.assets[k]):'Aucun fichier'})}
function openNew(){state.editing=null;emptyForm();$('#trackForm').elements.slug.readOnly=false;$('#editorTitle').textContent='Ajouter un titre';openModal('editorModal')}
function edit(slug){api('/api/tracks/'+encodeURIComponent(slug)).then(function(data){state.editing=slug;emptyForm();setForm(data.track.manifest);$('#editorTitle').textContent='Modifier '+data.track.manifest.title;openModal('editorModal')}).catch(function(e){showNotice(e.message,true)})}
function loadImageSource(blob){return new Promise(function(resolve,reject){if('createImageBitmap' in window){createImageBitmap(blob).then(resolve,reject);return}var url=URL.createObjectURL(blob);var image=new Image();image.onload=function(){URL.revokeObjectURL(url);resolve(image)};image.onerror=function(){URL.revokeObjectURL(url);reject(new Error('Pochette illisible.'))};image.src=url})}
async function createThumbnailBlob(blob){var source=await loadImageSource(blob);var size=512;var canvas=document.createElement('canvas');canvas.width=size;canvas.height=size;var ctx=canvas.getContext('2d',{alpha:false});ctx.fillStyle='#05030b';ctx.fillRect(0,0,size,size);var width=source.width||source.naturalWidth;var h

