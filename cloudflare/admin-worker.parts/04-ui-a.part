function renderAdminPage(email) {
  return ADMIN_HTML.replace("__USER_EMAIL__", escapeHtml(email));
}
function escapeHtml(value) { return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;"); }
function corsSafeHeaders() { return { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "same-origin", "Permissions-Policy": "camera=(), microphone=(), geolocation=()" }; }
function htmlResponse(html, status = 200) { return new Response(html, { status, headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "private, no-store", ...corsSafeHeaders() } }); }
function jsonResponse(payload, status = 200, extra = {}) { return new Response(JSON.stringify(payload, null, 2), { status, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "private, no-store", ...corsSafeHeaders(), ...extra } }); }

const ADMIN_HTML = String.raw`<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>LaunchPAD Track Manager</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f6f7f8;background:#090b0c;--green:#1db954;--panel:#111514;--line:rgba(255,255,255,.085);--muted:#91a098}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 8% -5%,rgba(29,185,84,.18),transparent 34%),radial-gradient(circle at 95% 5%,rgba(85,107,255,.11),transparent 27%),#090b0c;color:#f6f7f8}button,input,select,textarea{font:inherit}.app{width:min(1440px,calc(100% - 28px));margin:auto;padding:24px 0 70px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}.brand{display:flex;align-items:center;gap:13px}.logo{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:var(--green);color:#051108;font-weight:950;box-shadow:0 0 35px rgba(29,185,84,.25)}h1{font-size:clamp(1.3rem,2vw,1.9rem);margin:0}.sub{color:var(--muted);font-size:.86rem}.user{text-align:right}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:9px;margin-bottom:17px}.btn{border:1px solid var(--line);border-radius:11px;padding:10px 13px;background:#1a201e;color:#f5f7f6;cursor:pointer;transition:.16s}.btn:hover{transform:translateY(-1px);filter:brightness(1.08)}.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}.btn.primary{background:var(--green);color:#061108;border-color:transparent;font-weight:850}.btn.danger{background:rgba(255,70,86,.11);color:#ff9aa4;border-color:rgba(255,70,86,.23)}.search{margin-left:auto;min-width:min(320px,100%);border:1px solid var(--line);border-radius:11px;padding:10px 13px;background:#111514;color:#fff}.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:17px}.stat{padding:16px;border:1px solid var(--line);border-radius:15px;background:rgba(17,21,20,.83)}.stat b{display:block;font-size:1.45rem}.stat span{color:var(--muted);font-size:.78rem}.panel{border:1px solid var(--line);border-radius:20px;background:rgba(17,21,20,.88);box-shadow:0 24px 70px rgba(0,0,0,.25)}.panelhead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 19px;border-bottom:1px solid var(--line)}.panelhead h2{margin:0;font-size:1rem}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:14px}.track{display:grid;grid-template-columns:88px minmax(0,1fr);gap:13px;padding:13px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.022)}.cover{width:88px;aspect-ratio:1;border-radius:11px;object-fit:cover;background:#202523}.cover.placeholder{display:grid;place-items:center;color:#607067;font-size:.7rem}.track h3{margin:1px 0 4px;font-size:1rem;overflow-wrap:anywhere}.chips{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0}.chip{padding:4px 7px;border-radius:999px;background:rgba(255,255,255,.055);color:#b8c3bd;font-size:.67rem}.chip.ok{color:#7de7a3;background:rgba(29,185,84,.11)}.chip.warn{color:#ffd08a;background:rgba(255,174,54,.1)}.trackactions{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.small{padding:7px 9px;font-size:.75rem}.empty{padding:50px 20px;text-align:center;color:var(--muted)}.legacy{margin-top:16px}.legacylist{display:grid;gap:8px;padding:14px}.legacyrow{display:flex;align-items:center;justify-content:space-between;gap:13px;padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.02)}.notice{position:fixed;right:18px;bottom:18px;z-index:40;max-width:min(430px,calc(100% - 36px));padding:13px 15px;border-radius:12px;background:#18201c;border:1px solid var(--line);box-shadow:0 20px 55px #0008;display:none}.notice.show{display:block}.notice.error{color:#ffabb4;border-color:rgba(255,70,86,.3)}.modal{position:fixed;inset:0;z-index:30;display:none;place-items:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(8px)}.modal.open{display:grid}.dialog{width:min(980px,100%);max-height:92vh;overflow:auto;border:1px solid var(--line);border-radius:21px;background:#101412;box-shadow:0 35px 100px #000}.dialoghead{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:17px 19px;border-bottom:1px solid var(--line);background:rgba(16,20,18,.96);backdrop-filter:blur(14px)}.dialoghead h2{margin:0;font-size:1.05rem}.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;padding:18px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{color:#aab6af;font-size:.75rem;font-weight:720}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px 11px;background:#171c1a;color:#fff}.field textarea{min-height:80px;resize:vertical}.files{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;grid-column:1/-1}.filebox{padding:12px;border:1px dashed rgba(255,255,255,.14);border-radius:12px}.filebox small{display:block;color:var(--muted);margin-top:5px}.dialogfoot{display:flex;justify-content:flex-end;gap:9px;padding:0 18px 18px}.migration{padding:17px}.progress{height:8px;border-radius:999px;overflow:hidden;background:#242b28;margin:12px 0}.progress>div{height:100%;width:0;background:var(--green);transition:.2s}.migrationlist{max-height:360px;overflow:auto;display:grid;gap:7px}.migrationrow{display:flex;justify-content:space-betwe